quest_script_defs:  {
  defName:  "OpportunitySite_AbandonedPlatform"
  root:  {
    QuestNode_Sequence:  {
      nodes:  {
        value:  {
          QuestNode_IsSet:  {
            name:  "discoveryMethod"
            elseNode:  {
              QuestNode_RandomNode:  {
                nodes:  {
                  value:  {
                    QuestNode_Set:  {
                      name:  "discoveryMethod"
                      value:  "You have discovered"
                    }
                  }
                }
              }
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Root_Site:  {
            sitePartDef:  "Opportunity_AbandonedPlatform"
            worldObjectDef:  "ClaimableSpaceSite"
            distanceFromColonyRange:  "1~3"
            canBeSpace:  "true"
            requireSameOrAdjacentLayer:  "True"
            layerWhitelist:  "<li>Orbit</li>"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_WorldObjectTimeout:  {
            inSignalDisable:  "site.MapGenerated"
            delayTicks:  "$(randInt(45,60)*60000)"
            isQuestTimeout:  "true"
            node:  {
              QuestNode_Sequence:  {
                nodes:  {
                  value:  {
                    QuestNode_Letter:  {
                      label:  "Quest expired: [resolvedQuestName]"
                      text:  "Intercepted communications indicate the platform has been claimed by others. The quest [resolvedQuestName] has expired."
                    }
                  }
                }
                nodes:  {
                  value:  {
                    QuestNode_End:  {
                      outcome:  "Fail"
                    }
                  }
                }
              }
            }
            worldObject:  "$site"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_NoWorldObject:  {
            worldObject:  "$site"
            node:  {
              QuestNode_End:  {}
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Signal:  {
            inSignal:  "site.NoActiveThreats"
            node:  {
              QuestNode_End:  {
                outcome:  "Success"
              }
            }
          }
        }
      }
    }
  }
  rootSelectionWeight:  1
  autoAccept:  true
  expireDaysRange:  {
    min:  -1
    max:  -1
  }
  defaultChallengeRating:  -1
  isRootSpecial:  true
  questAvailableLetterTextIsDescription:  true
  affectedByPoints:  true
  sendAvailableLetter:  true
  endOnColonyMove:  true
  givenBy:  QUEST_GIVER_TAG_ORBITAL_SCANNER
  canOccurOnAllPlanetLayers:  true
  modPackageId:  "ludeon.rimworld.odyssey"
}
quest_script_defs:  {
  defName:  "OpportunitySite_AlphaThrumbo_Giver"
  root:  {
    QuestNode_Sequence:  {
      nodes:  {
        value:  {
          QuestNode_Set:  {
            name:  "siteDistRange"
            value:  "40~120"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetMap:  {
            storeAs:  "map"
            canBeSpace:  "true"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_IsSet:  {
            name:  "discoveryMethod"
            elseNode:  {
              QuestNode_RandomNode:  {
                nodes:  {
                  value:  {
                    QuestNode_Set:  {
                      name:  "discoveryMethod"
                      value:  "You have discovered"
                    }
                  }
                }
              }
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetSiteTile:  {
            storeAs:  "siteTile"
            preferCloserTiles:  "true"
            allowedLandmarks:  "<li>Oasis</li><li>Lake</li><li>LakeWithIsland</li><li>LakeWithIslands</li><li>Pond</li><li>DryLake</li><li>ToxicLake</li><li>Wetland</li><li>HotSprings</li><li>Archipelago</li><li>CoastalIsland</li><li>Peninsula</li><li>Bay</li><li>Fjord</li><li>CoastalAtoll</li><li>Iceberg</li><li>Valley</li><li>Cavern</li><li>Chasm</li><li>Crevasse</li><li>Plateau</li><li>IceDunes</li><li>Cliffs</li><li>Hollow</li><li>Basin</li><li>TerraformingScar</li><li>LavaLake</li><li>LavaCrater</li><li>LavaFlow</li><li>Dunes</li><li>Ruins</li><li>FrozenRuins</li><li>AncientSmokeVent</li><li>AncientHeatVent</li><li>AncientQuarry</li><li>AbandonedColonyTribal</li><li>AbandonedColonyOutlander</li><li>AncientLaunchSite</li><li>Harbor</li><li>AncientGarrison</li><li>AncientWarehouse</li><li>AncientChemfuelRefinery</li>"
            selectLandmarkChance:  "1"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetSitePartDefsByTagsAndFaction:  {
            sitePartsTags:  "<li><tag>AlphaThrumboSighting</tag></li>"
            storeAs:  "sitePartDefs"
            storeFactionAs:  "siteFaction"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetDefaultSitePartsParams:  {
            tile:  "$siteTile"
            faction:  "$siteFaction"
            sitePartDefs:  "$sitePartDefs"
            storeSitePartsParamsAs:  "sitePartsParams"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_SubScript:  {
            def:  "Util_GenerateSite"
            parms:  {
              value:  {
                name:  "hiddenSitePartsPossible"
                value:  "false"
              }
            }
            parms:  {
              value:  {
                name:  "worldObjectDef"
                value:  "ClaimableSite"
              }
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_SpawnWorldObjects:  {
            worldObjects:  "$site"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_WorldObjectTimeout:  {
            inSignalDisable:  "site.MapGenerated"
            delayTicks:  "$(randInt(25,35)*60000)"
            isQuestTimeout:  "true"
            node:  {
              QuestNode_Sequence:  {
                nodes:  {
                  value:  {
                    QuestNode_Letter:  {
                      label:  "Quest expired: [resolvedQuestName]"
                      text:  "Intercepted communications indicate the alpha thrumbo has moved on. The quest [resolvedQuestName] has expired."
                    }
                  }
                }
                nodes:  {
                  value:  {
                    QuestNode_End:  {
                      outcome:  "Fail"
                    }
                  }
                }
              }
            }
            worldObject:  "$site"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_NoWorldObject:  {
            worldObject:  "$site"
            node:  {
              QuestNode_End:  {}
            }
          }
        }
      }
    }
  }
  rootSelectionWeight:  0.15
  rootEarliestDay:  45
  minRefireDays:  300
  autoAccept:  true
  expireDaysRange:  {
    min:  -1
    max:  -1
  }
  defaultChallengeRating:  -1
  isRootSpecial:  true
  affectedByPoints:  true
