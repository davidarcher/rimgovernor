            elseNode:  {
              QuestNode_EvaluateSimpleCurve:  {
                storeAs:  "points"
                curve:  "<points><li>   35,   35</li><li>  400,  175</li><li> 1000,  300</li><li> 2000,  425</li><li> 3000,  700</li><li> 4000,  800</li><li> 5000,  900</li><li>10000, 1250</li></points>"
                value:  "$points"
