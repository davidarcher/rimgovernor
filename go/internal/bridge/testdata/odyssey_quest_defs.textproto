quest_script_defs:  {
  defName:  "SurveySite"
  root:  {
    QuestNode_Sequence:  {
      nodes:  {
        value:  {
          QuestNode_RequirementsToAcceptResearch:  {
            reserach:  "BasicGravtech"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_SubScript:  {
            def:  "Util_GetDefaultRewardValueFromPoints"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_SubScript:  {
            def:  "Util_AdjustPointsForDistantFight"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetMap:  {
            storeAs:  "map"
            canBeSpace:  "true"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_IsSet:  {
            name:  "asker"
            elseNode:  {
              QuestNode_RandomNode:  {
                nodes:  {
                  value:  {
                    QuestNode_Set:  {
                      selectionWeight:  "0.4"
                      name:  "askerIsNull"
                      value:  "true"
                    }
                  }
                }
                nodes:  {
                  value:  {
                    QuestNode_GetPawn:  {
                      selectionWeight:  "0.6"
                      storeAs:  "asker"
                      mustBeFactionLeader:  "true"
                      mustBeNonHostileToPlayer:  "true"
                      minTechLevel:  "Industrial"
                      hostileWeight:  "0"
                      factionMustBePermanent:  "True"
                      maxUsablePawnsToGenerate:  "10"
                    }
                  }
                }
              }
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Root_Site:  {
            sitePartDef:  "Opportunity_SurveySite"
            worldObjectDef:  "ClaimableSite"
            distanceFromColonyRange:  "20~80"
            allowedLandmarks:  "<li>Oasis</li><li>Lake</li><li>LakeWithIsland</li><li>LakeWithIslands</li><li>Pond</li><li>DryLake</li><li>ToxicLake</li><li>Wetland</li><li>HotSprings</li><li>Archipelago</li><li>CoastalIsland</li><li>Peninsula</li><li>Bay</li><li>Fjord</li><li>CoastalAtoll</li><li>Iceberg</li><li>Valley</li><li>Cavern</li><li>Chasm</li><li>Crevasse</li><li>Plateau</li><li>IceDunes</li><li>Cliffs</li><li>Hollow</li><li>Basin</li><li>TerraformingScar</li><li>LavaLake</li><li>LavaCrater</li><li>LavaFlow</li><li>Dunes</li><li>Ruins</li><li>FrozenRuins</li><li>AncientSmokeVent</li><li>AncientToxVent</li><li>AncientHeatVent</li><li>AncientQuarry</li><li>AbandonedColonyTribal</li><li>AbandonedColonyOutlander</li><li>AncientLaunchSite</li><li>Harbor</li><li>AncientGarrison</li><li>AncientWarehouse</li><li>AncientChemfuelRefinery</li>"
            selectLandmarkChance:  "1"
            desperateIgnoreDistance:  "true"
            requireSameOrAdjacentLayer:  "True"
            layerWhitelist:  "<li>Surface</li>"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_WorldObjectTimeout:  {
            inSignalDisable:  "site.MapGenerated"
            delayTicks:  "$(randInt(15,20)*60000)"
            isQuestTimeout:  "true"
            node:  {
              QuestNode_Sequence:  {
                nodes:  {
                  value:  {
                    QuestNode_Letter:  {
                      label:  "Quest expired: [resolvedQuestName]"
                      text:  "The scanner has gone offline. The quest [resolvedQuestName] has expired."
                    }
                  }
                }
                nodes:  {
                  value:  {
                    QuestNode_End:  {
                      outcome:  "Fail"
                    }
                  }
                }
              }
            }
            worldObject:  "$site"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Set:  {
            name:  "duration"
            value:  "$(randInt(10,15)*60000)"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Root_SurveyScanner:  {
            site:  "$site"
            duration:  "$duration"
            raidChance:  "1"
            raidAttackRemainingHoursRange:  "6~48"
            raidLetterText:  "{BASETEXT}\n\nThe [enemyFaction_pawnsPlural] [attackReason]."
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GenerateThingSet:  {
            storeAs:  "upgradeItem"
            thingSetMaker:  "Reward_GravshipUpgrade"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_AllSignals:  {
            inSignals:  "<li>site.SurveyCompleted</li>"
            node:  {
              QuestNode_Delay:  {
                delayTicks:  "300"
                node:  {
                  QuestNode_Sequence:  {
                    nodes:  {
                      value:  {
                        QuestNode_Letter:  {
                          letterDef:  "PositiveEvent"
                          label:  "Quest completed"
                          text:  "You have successfully completed the quest '[resolvedQuestName]'!"
                        }
                      }
                    }
                    nodes:  {
                      value:  {
                        QuestNode_AddItemsReward:  {
                          items:  "$upgradeItem"
                          generateQuestParts:  true
                        }
                      }
                    }
                    nodes:  {
                      value:  {
                        QuestNode_End:  {
                          outcome:  "Success"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_NoWorldObject:  {
            worldObject:  "$site"
            node:  {
              QuestNode_End:  {
                outcome:  "Fail"
              }
            }
          }
        }
      }
    }
  }
  rootSelectionWeight:  1
  randomlySelectable:  true
  minRefireDays:  30
  expireDaysRange:  {
    min:  20
    max:  30
  }
  defaultChallengeRating:  -1
  affectedByPoints:  true
  sendAvailableLetter:  true
  endOnColonyMove:  true
  everAcceptableInSpace:  true
  canOccurOnAllPlanetLayers:  true
  modPackageId:  "ludeon.rimworld.odyssey"
}
quest_script_defs:  {
  defName:  "ThreatReward_Raid_Joiner"
  root:  {
    QuestNode_Sequence:  {
      nodes:  {
        value:  {
          QuestNode_SubScript:  {
            def:  "Util_RandomizePointsChallengeRating"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetMap:  {
            storeAs:  "map"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetWalkInSpot:  {
            storeAs:  "walkInSpot"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_GetFaction:  {
            storeAs:  "enemyFaction"
            allowEnemy:  "true"
            mustBePermanentEnemy:  "true"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_SubScript:  {
            def:  "Util_JoinerThreat_Joiner"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Set:  {
            name:  "raidDelayTicks"
            value:  "$(roundToTicksRough(randInt(1800, 2400)))"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Delay:  {
            delayTicks:  "$raidDelayTicks"
            node:  {
              QuestNode_SubScript:  {
                def:  "Util_Raid"
                prefix:  "raid"
                parms:  {
                  value:  {
                    name:  "inSignal"
                    value:  "$inSignal"
                  }
                }
                parms:  {
                  value:  {
                    name:  "map"
                    value:  "$map"
                  }
                }
                parms:  {
                  value:  {
                    name:  "points"
                    value:  "$points"
                  }
                }
                parms:  {
                  value:  {
                    name:  "enemyFaction"
                    value:  "$enemyFaction"
                  }
                }
                parms:  {
                  value:  {
                    name:  "walkInSpot"
                    value:  "$walkInSpot"
                  }
                }
                parms:  {
                  value:  {
                    name:  "customLetterLabel"
                    value:  "{BASELABEL} chasing [../joiner_nameDef]"
                  }
                }
                parms:  {
                  value:  {
                    name:  "customLetterText"
                    value:  "{BASETEXT}\n              \nThe [enemyFaction_pawnsPlural] have come to get [../joiner_nameDef]."
                  }
                }
              }
            }
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Delay:  {
            delayTicks:  "$($raidDelayTicks+600)"
            node:  {
              QuestNode_End:  {}
            }
          }
        }
      }
    }
  }
  rootSelectionWeight:  0.6
  randomlySelectable:  true
  rootIncreasesPopulation:  true
  expireDaysRange:  {
    min:  0.3
    max:  0.3
  }
  defaultChallengeRating:  -1
  affectedByPoints:  true
  defaultCharity:  true
  failedOrExpiredHistoryEvent:  "CharityRefused_ThreatReward_Joiner"
  sendAvailableLetter:  true
  endOnColonyMove:  true
  modPackageId:  "ludeon.rimworld"
}
