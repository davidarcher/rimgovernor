quest_script_defs:  {
  defName:  "Util_RaidDelayRepeatable"
  root:  {
    QuestNode_Sequence:  {
      nodes:  {
        value:  {
          QuestNode_GetFaction:  {
            storeAs:  "enemyFaction"
            allowEnemy:  "true"
            mustBePermanentEnemy:  "true"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Set:  {
            name:  "nextRaidDelayTicks"
            value:  "$firstRaidDelayTicks"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Set:  {
            name:  "raidCountMinusOne"
            value:  "$raidCount"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_Subtract:  {
            value1:  "$raidCountMinusOne"
            value2:  "1"
            storeAs:  "raidCountMinusOne"
          }
        }
      }
      nodes:  {
        value:  {
          QuestNode_LoopCount:  {
            node:  {
              QuestNode_Sequence:  {
                nodes:  {
                  value:  {
                    QuestNode_IsNull:  {
                      value:  "$raid(($raidLoopCounter))/raidDelayTicks"
                      elseNode:  {
                        QuestNode_Set:  {
                          name:  "nextRaidDelayTicks"
                          value:  "$raid(($raidLoopCounter))/raidDelayTicks"
                        }
                      }
                    }
                  }
                }
                nodes:  {
                  value:  {
                    QuestNode_Delay:  {
                      delayTicks:  "$nextRaidDelayTicks"
                      waitUntilPlayerHasHomeMap:  "true"
                      node:  {
                        QuestNode_Sequence:  {
                          nodes:  {
                            value:  {
                              QuestNode_SubScript:  {
                                def:  "Util_Raid"
                                prefix:  "raid$raidLoopCounter"
                                parms:  {
                                  value:  {
                                    name:  "tag"
                                    value:  "lord"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "inSignal"
                                    value:  "$inSignal"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "map"
                                    value:  "$map"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "enemyFaction"
                                    value:  "$enemyFaction"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "points"
                                    value:  "$points"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "walkInSpot"
                                    value:  "$walkInSpot"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "customLetterLabel"
                                    value:  "$customLetterLabel"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "customLetterText"
                                    value:  "$customLetterText"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "customLetterLabelRules"
                                    value:  "$customLetterLabelRules"
                                  }
                                }
                                parms:  {
                                  value:  {
                                    name:  "customLetterTextRules"
                                    value:  "$customLetterTextRules"
                                  }
                                }
                              }
                            }
                          }
                          nodes:  {
                            value:  {
                              QuestNode_Equal:  {
                                value1:  "$raidLoopCounter"
                                value2:  "$($raidCount - 1)"
                                compareAs:  "int"
                                node:  {
                                  QuestNode_SendSignals:  {
                                    outSignals:  "AllRaidsSent"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
                nodes:  {
                  value:  {
                    QuestNode_Add:  {
                      value1:  "$nextRaidDelayTicks"
                      value2:  "9000"
                      storeAs:  "nextRaidDelayTicks"
                    }
                  }
                }
              }
            }
            loopCount:  "$raidCount"
            storeLoopCounterAs:  "raidLoopCounter"
          }
        }
      }
    }
  }
  randomlySelectable:  true
  expireDaysRange:  {
