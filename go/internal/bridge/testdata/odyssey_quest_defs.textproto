          QuestNode_GenerateThingSet:  {
            storeAs:  "itemPodsContents"
            thingSetMaker:  "Reward_ItemsStandard"
            totalMarketValueRange:  "$itemPodsTotalMarketValueRange"
            factionOf:  "$asker"
            qualityGenerator:  "Reward"
          }
        }
