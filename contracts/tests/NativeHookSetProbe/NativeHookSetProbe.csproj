<Project Sdk="Microsoft.NET.Sdk">
  <!-- NativeConstructionHookSet against real Harmony (#935). Separate from NativeContractProbes
       because that project's Harmony-gated build does not compile (its shared fakes collide with
       the native-authority-hooks stubs), and these checks need real Harmony, not FakeHarmonyStub. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NativeSourceRoot>$(MSBuildThisFileDirectory)../../../integrations/rimgovernor-native/src</NativeSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssembly)</HintPath><Private>true</Private></Reference>
    <Compile Include="Program.cs" />
    <Compile Include="$(NativeSourceRoot)/Bridge/Protocol/NativeConstructionHookSet.cs" Link="Production/NativeConstructionHookSet.cs" />
  </ItemGroup>
</Project>
