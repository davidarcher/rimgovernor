<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BrainReloadSpike</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <!-- Built before the host but never referenced: the host loads it from bytes at run time. -->
    <ProjectReference Include="../Brain/Brain.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyBrain" AfterTargets="Build">
    <ItemGroup>
      <BrainOutput Include="$(MSBuildThisFileDirectory)../Brain/bin/$(Configuration)/$(TargetFramework)/RimGovernor.BrainSpike.Brain.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BrainOutput)" DestinationFolder="$(OutDir)brain" />
  </Target>
</Project>
