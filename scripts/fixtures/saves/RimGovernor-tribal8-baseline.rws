										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li>
								<name>bloodfeeders</name>
								<def>Bloodfeeders_Revered</def>
								<ID>258</ID>
								<randomSeed>-1585024261</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Jubilee of War</name>
								<def>Festival</def>
								<ID>259</ID>
								<randomSeed>-1779259405</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A dance party with drums. Participants will gather, socialize, play drums, and dance to have fun and connect with each other.</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Every year on {DATE}, {MEMBERS} can have a special celebration.</ritualExpectedDesc>
								<shortDescOverride>drum party</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/CelebrationPartyDanceDrums</iconPathOverride>
								<patternGroupTag>CelebratedDate</patternGroupTag>
								<maxTechLevel>Neolithic</maxTechLevel>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>CelebrationPartyDanceDrum</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_CampfireParty">
									<def>RitualSpotOrCampfireParty</def>
									<parent>Precept_259</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_PartyDanceDrums">
									<def>CelebrationPartyDanceDrum</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>6</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<attachableOutcomeEffect>RechargePsyfocus</attachableOutcomeEffect>
								<outcomeEffect Class="RitualOutcomeEffectWorker_DanceParty">
									<def>CelebrationPartyDanceDrum</def>
									<compDatas>
