							<deities>
								<li>
									<name>Tedeuteus</name>
									<type>Mother of Femininity</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>FemaleSupremacy</relatedMeme>
