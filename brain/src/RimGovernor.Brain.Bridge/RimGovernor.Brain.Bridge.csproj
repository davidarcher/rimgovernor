<Project Sdk="Microsoft.NET.Sdk">
  <!-- The catalog derivations (#3056) over the game's own Def types, and the typed boundary
       between the in-process brain and the native mod (#3080): INativeFacade, the frame handoff and the facade registry.
       Game references and the `unavailable` empty build come from Game.props. -->
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Bridge</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Bridge</AssemblyName>
    <!-- tools/rg publishes win-x64 ReadyToRun and restores this project with that RID; declaring it keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <Import Project="../../Game.props" />
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge.Contracts/RimGovernor.Brain.Bridge.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RimGovernor.Brain.Domain.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameAvailable)' == 'true'">
    <Using Include="RimGovernor.Brain.Domain" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="RimGovernor.Brain.BuildingRuntime" /><InternalsVisibleTo Include="RimGovernor.RealCombat.Native" /></ItemGroup>
</Project>
