<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.BuildingRuntime</RootNamespace>
    <AssemblyName>RimGovernor.Brain.BuildingRuntime</AssemblyName>
  </PropertyGroup>
  <Import Project="../../Game.props" />
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge.Contracts/RimGovernor.Brain.Bridge.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge/RimGovernor.Brain.Bridge.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Facts/RimGovernor.Brain.Facts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Observation/RimGovernor.Brain.Observation.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Store/RimGovernor.Brain.Store.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Snapshot/RimGovernor.Brain.Snapshot.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Executor/RimGovernor.Brain.Executor.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Simulation/RimGovernor.Brain.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Go's domain.Known / domain.Unknown read the same in C#. -->
    <Using Include="RimGovernor.Brain.Domain" />
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
    <Using Include="RimGovernor.Brain.Policy" />
    <!-- Packages the Go root package imports that are not ported yet; each is awaiting its own slice. -->
    <Using Include="RimGovernor.Brain.Observation" />
    <Using Include="RimGovernor.Brain.Store" />
    <Using Include="RimGovernor.Brain.Bridge" />
    <Using Include="RimGovernor.Brain.Telemetry" />
    <Using Include="RimGovernor.Brain.Snapshot" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.Result" Alias="BridgeResult" />
    <Using Include="RimGovernor.Brain.Executor" />
    <Using Include="RimGovernor.Brain.Facts" />
    <Using Include="RimGovernor.Contracts.Wire" />
    <!-- Go package-level functions with no owning type live on one static partial class per package. -->
    <Using Include="RimGovernor.Brain.BuildingRuntime.BuildingRuntimePackage" Static="true" />
    <Using Include="RimGovernor.Brain.Policy.PolicyConstants" Static="true" />
    <Using Include="RimGovernor.Brain.Policy.PolicyFunctions" Static="true" />
    <Using Include="RimGovernor.Brain.BuildingRuntime.Verdict" Static="true" />
    <!-- Namespace and class share a name in the unported packages, so the namespace shadows the class; these name the class. -->
    <Using Include="RimGovernor.Brain.Observation.ObservationPackage" Alias="ObservationApi" />
    <Using Include="RimGovernor.Brain.Snapshot.SnapshotPackage" Alias="Snap" />
    <Using Include="RimGovernor.Brain.Snapshot.SnapshotPackage" Alias="SnapshotApi" />
    <Using Include="RimGovernor.Brain.Store.Store" Alias="JournalStore" />
    <!-- Go's wire package aliases (a, c, k, n, o, r). -->
    <Using Include="RimGovernor.Contracts.Wire.Authority" Alias="PbAuthority" />
    <Using Include="RimGovernor.Contracts.Wire.Common" Alias="PbCommon" />
    <Using Include="RimGovernor.Contracts.Wire.Clock" Alias="PbClock" />
    <Using Include="RimGovernor.Contracts.Wire.Observations" Alias="PbObservations" />
    <Using Include="RimGovernor.Contracts.Wire.Operations" Alias="PbOperations" />
    <Using Include="RimGovernor.Contracts.Wire.Receipts" Alias="PbReceipts" />
    <Using Include="RimGovernor.Contracts.Wire.Presentation" Alias="PbPresentation" />
    <Using Include="RimGovernor.Contracts.Wire.Lifecycle" Alias="PbLifecycle" />
    <!-- Names two imported namespaces both declare: Policy and Telemetry/Executor shapes win (issue #3111). -->
    <Using Include="RimGovernor.Brain.Policy.PawnId" Alias="PawnId" />
    <Using Include="RimGovernor.Brain.Policy.Amount" Alias="Amount" />
    <Using Include="RimGovernor.Brain.Telemetry.Decision" Alias="Decision" />
    <Using Include="RimGovernor.Brain.Executor.IClock" Alias="IClock" />
    <Using Include="RimGovernor.Brain.Domain.ControllerSessionId" Alias="ControllerSessionId" />
    <Using Include="RimGovernor.Brain.Observation.Identity" Alias="Identity" />
    <Using Include="RimGovernor.Brain.Policy.RecoveryMethod" Alias="RecoveryMethod" />
    <!-- Go's bridge.X where the policy or domain package declares the same name. -->
    <Using Include="RimGovernor.Brain.Bridge.Contracts.CellRect" Alias="BridgeCellRect" />
    <Using Include="RimGovernor.Brain.Observation.Combat" Alias="BridgeCombat" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.CombatOrderResult" Alias="BridgeCombatOrderResult" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.DefenseCell" Alias="BridgeDefenseCell" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.DefenseCover" Alias="BridgeDefenseCover" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.DefenseSite" Alias="BridgeDefenseSite" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.EmergencyObservation" Alias="BridgeEmergencyObservation" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.EquipCandidate" Alias="BridgeEquipCandidate" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.EquipRead" Alias="BridgeEquipRead" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.ExcavationSite" Alias="BridgeExcavationSite" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.GrowerCropTarget" Alias="BridgeGrowerCropTarget" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.LinesOfFire" Alias="BridgeLinesOfFire" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.MapBounds" Alias="BridgeMapBounds" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.RoundsFrame" Alias="BridgeRoundsFrame" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.SpatialAccess" Alias="BridgeSpatialAccess" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.Things" Alias="BridgeThings" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.BuildingPreview" Alias="BridgeBuildingPreview" />
    <!-- Go's facts package types. -->
    <Using Include="RimGovernor.Brain.Facts.Scope" Alias="FactScope" />
    <Using Include="RimGovernor.Brain.Facts.Section" Alias="FactSection" />
    <Using Include="RimGovernor.Brain.Facts.Rect" Alias="FactRect" />
    <Using Include="RimGovernor.Contracts.Wire.Operations" Alias="OP" />
    <Using Include="RimGovernor.Brain.Store.Store" Alias="StoreJournal" />
    <Using Include="RimGovernor.Brain.Store.World" Alias="StoreWorld" />
    <Using Include="RimGovernor.Brain.Store.Rounds" Alias="RoundsReview" />
    <Using Include="RimGovernor.Brain.Observation.Policies" Alias="ObservationPolicies" />
    <Using Include="RimGovernor.Brain.Policy.PolicyFunctions" Alias="PolicyApi" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.PlanningWindow" Alias="PlanningWindowRead" />
    <Using Include="RimGovernor.Brain.Policy.DefenseCell" Alias="DefenseCell" />
    <!-- Go's package qualifiers for functions with no owning type. -->
    <Using Include="RimGovernor.Brain.Bridge.Contracts.BridgeFunctions" Alias="BridgeApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host's native client (#3113) implements this assembly's internal source interfaces. -->
    <InternalsVisibleTo Include="RimGovernor.Brain.Host" />
  </ItemGroup>
</Project>
