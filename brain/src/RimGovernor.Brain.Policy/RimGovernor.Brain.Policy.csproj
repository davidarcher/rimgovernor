<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Policy</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Policy</AssemblyName>
    <!-- tools/rg publishes win-x64 ReadyToRun and restores this project with that RID; declaring it keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mood audit table, embedded unchanged. -->
    <EmbeddedResource Include="thought_triggers.tsv" LogicalName="thought_triggers.tsv" />
    <!-- Mechanic cards of the defs with a live consumer, generated by RimGovernor.cmd thoughtaudit -guards (#3220). -->
    <EmbeddedResource Include="mechanic_cards.json" LogicalName="mechanic_cards.json" />
    <!-- The raid exposure table the combat sweep calibrates (#3541); a fixture table until the calibrated one lands. -->
    <EmbeddedResource Include="Harm/exposure.json" LogicalName="exposure.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The unwired effect-source family (#3224) is internal like the other Method generators; its tests call it directly. -->
    <InternalsVisibleTo Include="RimGovernor.Brain.Domain.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Domain.Known / Domain.Unknown, and the package-level consts and functions with no owner type. -->
    <Using Include="RimGovernor.Brain.Domain" />
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
    <!-- The native room census rows (#3764): Policy reads rooms through functions over them. -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.RoomRole" Alias="RoomRole" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.RoomState" Alias="RoomState" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.RoomDoor" Alias="RoomDoor" />
    <!-- The native clearance census floor rows (#3774). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.ClearanceFloor" Alias="ClearanceFloor" />
    <!-- The native pawn table's policy inputs (#3768). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnPolicyInputs" Alias="PawnPolicyInputs" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnIdeo" Alias="PawnIdeo" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.GuestState" Alias="GuestState" />
    <!-- The DLC colony sections and pawn blocks (#3773). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnRoyalHolding" Alias="PawnRoyalHolding" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnPsylink" Alias="PawnPsylink" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.BestowingCeremony" Alias="BestowingCeremony" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.RoyalThrone" Alias="RoyalThrone" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnAnomaly" Alias="PawnAnomaly" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnAnomalyState" Alias="PawnAnomalyState" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.CreepJoinerState" Alias="CreepJoinerState" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.HeldState" Alias="HeldState" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.StudyState" Alias="StudyState" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.AnomalyDoor" Alias="AnomalyDoor" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.EntityContainmentModeKind" Alias="EntityContainmentModeKind" />
    <!-- The gear census's climate and option source (#3777). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.GearClimate" Alias="GearClimate" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.GearSource" Alias="GearSource" />
    <!-- The native health and surgery rows the care planners read (#3788). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.Hediff" Alias="Hediff" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.PawnConditions" Alias="PawnConditions" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.HediffTend" Alias="HediffTend" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.HediffImmunity" Alias="HediffImmunity" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.ImmunityGain" Alias="ImmunityGain" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.SurgeryOperation" Alias="SurgeryOperation" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.SurgeryChance" Alias="SurgeryChance" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.SurgeryKind" Alias="SurgeryKind" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.MissingBodyPart" Alias="MissingBodyPart" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.AnimalPregnancy" Alias="AnimalPregnancy" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.AnimalNextLifeStage" Alias="AnimalNextLifeStage" />
    <!-- The population read's ideology mode and owned names (#3785). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.ColonyIdeology" Alias="ColonyIdeology" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.OwnedName" Alias="OwnedName" />
    <!-- A construction site's finishing minimum and tier gate (#3874). -->
    <Using Include="RimGovernor.Contracts.Wire.Observations.FinishingMinimum" Alias="FinishingMinimum" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.ConstructionGate" Alias="ConstructionGate" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.WorldSite" Alias="WorldSite" />
  </ItemGroup>
</Project>
