<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Policy</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Policy</AssemblyName>
    <!-- tools/rg publishes win-x64 ReadyToRun and restores this project with that RID; declaring it keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mood audit table is the Go package's file, embedded unchanged so one copy serves both until cutover. -->
    <EmbeddedResource Include="thought_triggers.tsv" LogicalName="thought_triggers.tsv" />
    <!-- Mechanic cards of the defs with a live consumer, generated by RimGovernor.cmd thoughtaudit -guards (#3220). -->
    <EmbeddedResource Include="mechanic_cards.json" LogicalName="mechanic_cards.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The unwired effect-source family (#3224) is internal like the other Method generators; its tests call it directly. -->
    <InternalsVisibleTo Include="RimGovernor.Brain.Domain.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Go's domain.Known / domain.Unknown, and the package-level consts and functions with no owner type. -->
    <Using Include="RimGovernor.Brain.Domain" />
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
  </ItemGroup>
</Project>
