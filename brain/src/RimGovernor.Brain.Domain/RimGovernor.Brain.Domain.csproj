<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Domain</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Domain</AssemblyName>
    <!-- tools/rg publishes win-x64 ReadyToRun and restores this project with that RID; declaring it keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Known(v) and Unknown<T>() are used unqualified. -->
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
  </ItemGroup>
</Project>
