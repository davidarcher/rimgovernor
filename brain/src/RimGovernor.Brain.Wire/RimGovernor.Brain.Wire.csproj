<Project Sdk="Microsoft.NET.Sdk">
  <!-- Temporary: link-compiles the generated protobuf C# until protobuf collapses to plain records (#3100).
       Generated-code relaxations are scoped to this project only. -->
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Wire</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Wire</AssemblyName>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <Compile Include="../../../contracts/generated/protobuf/csharp/*.cs" Link="Generated/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
