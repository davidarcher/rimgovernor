<Project Sdk="Microsoft.NET.Sdk">
  <!-- Value types and validators of Go internal/bridge that observation, snapshot, store and facts consume.
       Deliberately free of the game assemblies: the catalog derivations (#3056) live in RimGovernor.Brain.Bridge. -->
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Bridge.Contracts</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Bridge.Contracts</AssemblyName>
    <!-- tools/rg publishes win-x64 ReadyToRun and restores this project with that RID; declaring it keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Go's domain.Known / domain.Unknown, and the package-level consts and functions with no owner type. -->
    <Using Include="RimGovernor.Brain.Domain" />
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
    <!-- The wire messages share these names with domain values; this project names the wire message. -->
    <Using Include="RimGovernor.Contracts.Wire.Common.Identity" Alias="Identity" />
    <Using Include="RimGovernor.Contracts.Wire.Common.Cell" Alias="Cell" />
    <Using Include="RimGovernor.Contracts.Wire.Receipts.UnsuccessfulReason" Alias="UnsuccessfulReason" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.BridgeConstants" Static="true" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.BridgeFunctions" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host's native client (#3113) decodes and validates the replies this assembly's read models describe. -->
    <InternalsVisibleTo Include="RimGovernor.Brain.Host" />
  </ItemGroup>
</Project>
