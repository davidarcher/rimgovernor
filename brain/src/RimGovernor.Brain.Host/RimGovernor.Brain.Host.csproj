<Project Sdk="Microsoft.NET.Sdk">
  <!-- The brain host (#3082): the lifecycle, scheduler thread, authority and fault isolation that run the whole
       brain inside the mod behind -rimgovernor-inproc. It composes the other projects and adds the process-level
       concerns they leave out; it references no game assembly. -->
  <PropertyGroup>
    <!-- Reachable from the acceptance tool published for win-x64; keep the locked restore graph stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>RimGovernor.Brain.Host</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.GameFacts/RimGovernor.Brain.GameFacts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.GameOrders/RimGovernor.Brain.GameOrders.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.GameAccess/RimGovernor.Brain.GameAccess.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge/RimGovernor.Brain.Bridge.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Store/RimGovernor.Brain.Store.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Executor/RimGovernor.Brain.Executor.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Runtime/RimGovernor.Brain.Runtime.csproj" />
   <ProjectReference Include="../RimGovernor.Brain.HttpChannel/RimGovernor.Brain.HttpChannel.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.PlayerApi/RimGovernor.Brain.PlayerApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The headless real-engine host drives the live combat read over its arena (#3142). -->
    <InternalsVisibleTo Include="RimGovernor.RealCombat.Native" />
    <InternalsVisibleTo Include="RimGovernor.Brain.Domain.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Names two imported namespaces both declare, or a namespace that shares its class's name. -->
    <Using Include="RimGovernor.Brain.Store.Store" Alias="StoreJournal" />
  </ItemGroup>
</Project>
