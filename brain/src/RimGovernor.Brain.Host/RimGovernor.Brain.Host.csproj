<Project Sdk="Microsoft.NET.Sdk">
  <!-- The brain host (#3082): the lifecycle, scheduler thread, authority and fault isolation that run the whole
       brain inside the mod behind -rimgovernor-inproc. It composes the other projects and adds the process-level
       concerns they leave out; it references no game assembly. -->
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Host</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge.Contracts/RimGovernor.Brain.Bridge.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Facts/RimGovernor.Brain.Facts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge/RimGovernor.Brain.Bridge.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Snapshot/RimGovernor.Brain.Snapshot.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Observation/RimGovernor.Brain.Observation.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Store/RimGovernor.Brain.Store.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Executor/RimGovernor.Brain.Executor.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.BuildingRuntime/RimGovernor.Brain.BuildingRuntime.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.NativeFacade/RimGovernor.Brain.NativeFacade.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.HttpChannel/RimGovernor.Brain.HttpChannel.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.PlayerApi/RimGovernor.Brain.PlayerApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Names two imported namespaces both declare, or a namespace that shares its class's name. -->
    <Using Include="RimGovernor.Brain.Store.Store" Alias="StoreJournal" />
    <Using Include="RimGovernor.Brain.Observation.IClock" Alias="ObservationClock" />
    <Using Include="RimGovernor.Brain.Executor.IClock" Alias="ExecutorClock" />
    <Using Include="RimGovernor.Contracts.Wire.Authority" Alias="PbAuthority" />
    <Using Include="RimGovernor.Contracts.Wire.Common" Alias="PbCommon" />
    <Using Include="RimGovernor.Contracts.Wire.Lifecycle" Alias="PbLifecycle" />
    <Using Include="RimGovernor.Contracts.Wire.Operations" Alias="PbOperations" />
    <Using Include="RimGovernor.Contracts.Wire.Observations" Alias="PbObservations" />
    <Using Include="RimGovernor.Contracts.Wire.Clock" Alias="PbClock" />
    <Using Include="RimGovernor.Contracts.Wire.Presentation" Alias="PbPresentation" />
    <Using Include="RimGovernor.Contracts.Wire.Placement" Alias="PbPlacement" />
    <Using Include="RimGovernor.Contracts.Wire.Mirror" Alias="PbMirror" />
    <Using Include="RimGovernor.Contracts.Wire.Receipts" Alias="PbReceipts" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.Result" Alias="BridgeResult" />
  </ItemGroup>
</Project>
