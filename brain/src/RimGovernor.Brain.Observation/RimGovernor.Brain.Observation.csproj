<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reachable from the acceptance tool published for win-x64; keep the locked restore graph stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>RimGovernor.Brain.Observation</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Observation</AssemblyName>
  </PropertyGroup>
  <Import Project="../../Game.props" />
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge.Contracts/RimGovernor.Brain.Bridge.Contracts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge/RimGovernor.Brain.Bridge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.Domain" />
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
    <Using Include="RimGovernor.Brain.Policy" />
    <Using Include="RimGovernor.Brain.Facts" />
    <!-- Package-level policy functions and constants live on two static partial classes. -->
    <Using Include="RimGovernor.Brain.Bridge.Contracts" />
    <Using Include="RimGovernor.Brain.Bridge.DefinitionCatalog" Alias="DefinitionCatalog" />
    <Using Include="RimGovernor.Brain.Bridge.BiotechCatalog" Alias="BiotechCatalog" />
    <Using Include="RimGovernor.Brain.Bridge.CatalogStat" Alias="CatalogStat" />
    <Using Include="RimGovernor.Brain.Bridge.CatalogStats" Alias="CatalogStats" />
    <!-- Wire namespaces under short aliases. -->
    <Using Include="RimGovernor.Contracts.Wire.Common" Alias="C" />
    <Using Include="RimGovernor.Contracts.Wire.Defs" Alias="D" />
    <Using Include="RimGovernor.Contracts.Wire.Observations" Alias="O" />
    <Using Include="RimGovernor.Contracts.Wire.Lifecycle" Alias="L" />
    <Using Include="RimGovernor.Contracts.Wire.Operations" Alias="Ops" />
    <!-- The wire message shares this name with the domain value; this project names the domain value. -->
    <Using Include="RimGovernor.Brain.Domain.Cell" Alias="Cell" />
    <Using Include="RimGovernor.Brain.Domain.PawnId" Alias="PawnId" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.RoomRole" Alias="RoomRole" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.RoomState" Alias="RoomState" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.GearClimate" Alias="GearClimate" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.GearSource" Alias="GearSource" />
    <Using Include="RimGovernor.Contracts.Wire.Observations.WorldSite" Alias="WorldSite" />
    <!-- Observation-local type names for policy values. -->
    <Using Include="RimGovernor.Brain.Policy.RoleScore" Alias="RoleContribution" />
    <!-- Package-level functions with no owning type live on one static partial class per package. -->
  </ItemGroup>
  <ItemGroup>
    <!-- The host's native client (#3113) implements this assembly's source interfaces. -->
    <InternalsVisibleTo Include="RimGovernor.Brain.BuildingRuntime" />
    <!-- The headless combat host reads the royalty facts of its arena frame as the rounds do. -->
    <InternalsVisibleTo Include="RimGovernor.RealCombat.Native" />
    <!-- The catalog decode tests read the planning rows the views build. -->
    <InternalsVisibleTo Include="RimGovernor.Brain.Domain.Tests" />
  </ItemGroup>
</Project>
