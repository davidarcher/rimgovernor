<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Observation</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Observation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Facts/RimGovernor.Brain.Facts.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Wire/RimGovernor.Brain.Wire.csproj" />
    <ProjectReference Include="../RimGovernor.Brain.Bridge.Contracts/RimGovernor.Brain.Bridge.Contracts.csproj" />
    <!-- Awaiting #3056: the catalog derivations (RepairPriority, TraitEffects, ...) extend DefinitionCatalog from
         RimGovernor.Brain.Bridge; reference it here once it exists on main. -->
  </ItemGroup>
  <ItemGroup>
    <!-- Go's domain.Known / domain.Unknown read the same in C#. -->
    <Using Include="RimGovernor.Brain.Domain" />
    <Using Include="RimGovernor.Brain.Domain.Fact" Static="true" />
    <Using Include="RimGovernor.Brain.Policy" />
    <Using Include="RimGovernor.Brain.Facts" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.BridgeConstants" Static="true" />
    <Using Include="RimGovernor.Brain.Bridge.Contracts.BridgeFunctions" Static="true" />
    <!-- Wire namespaces under the short names the Go imports used (c, d, o, l, operationspb). -->
    <Using Include="RimGovernor.Protocol.Common" Alias="C" />
    <Using Include="RimGovernor.Protocol.Defs" Alias="D" />
    <Using Include="RimGovernor.Protocol.Observations" Alias="O" />
    <Using Include="RimGovernor.Protocol.Lifecycle" Alias="L" />
    <Using Include="RimGovernor.Protocol.Operations" Alias="Ops" />
    <!-- The wire message shares this name with the domain value; this project names the domain value. -->
    <Using Include="RimGovernor.Brain.Domain.Cell" Alias="Cell" />
    <!-- Domain and Policy each declare a PawnId (Go domain.PawnID and policy.PawnID); the policy one is the common case. -->
    <Using Include="RimGovernor.Brain.Policy.PawnId" Alias="PawnId" />
    <!-- Go's observation-local type names for policy values. -->
    <Using Include="RimGovernor.Brain.Policy.Room" Alias="ObservedRoom" />
    <Using Include="RimGovernor.Brain.Policy.RoleScore" Alias="RoleContribution" />
    <!-- Go package-level functions with no owning type live on one static partial class per package. -->
    <Using Include="RimGovernor.Brain.Observation.ObservationPackage" Static="true" />
  </ItemGroup>
</Project>
