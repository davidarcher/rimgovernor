<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# acceptance harness (#3087): drives the game over the local HTTP channel, hosts the case registry and
       the setup, doctor and postmortem tools behind `RimGovernor.cmd acceptance`. Cases live in
       RimGovernor.Brain.Acceptance.Cases and register through the public API of this project. -->
  <PropertyGroup>
    <RootNamespace>RimGovernor.Brain.Acceptance</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Acceptance</AssemblyName>
    <!-- GameHost's source-generated LibraryImport (detached CreateProcess) emits unsafe stubs. -->
    <!-- tools/rg publishes win-x64 ReadyToRun and restores this project with that RID; declaring it keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RimGovernor.Brain.HttpChannel\RimGovernor.Brain.HttpChannel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RimGovernor.Brain.Telemetry\RimGovernor.Brain.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RimGovernor.Brain.Contracts\RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Domain\RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Policy\RimGovernor.Brain.Policy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" />
    <PackageReference Include="SourceGear.sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The suite data the Go build embedded: the committed suites and the shard planner's measured case times. -->
    <EmbeddedResource Include="Suites\Data\*.json" LogicalName="RimGovernor.Brain.Acceptance.Suites.%(Filename)%(Extension)" />
    <ProjectReference Include="..\RimGovernor.Brain.Simulation\RimGovernor.Brain.Simulation.csproj" />
  </ItemGroup>
</Project>
