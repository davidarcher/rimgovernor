<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reachable from the acceptance tool published for win-x64; keep the locked restore graph stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>RimGovernor.Brain.PlayerApi</RootNamespace>
    <AssemblyName>RimGovernor.Brain.PlayerApi</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RimGovernor.Brain.HttpChannel\RimGovernor.Brain.HttpChannel.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Domain\RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Store\RimGovernor.Brain.Store.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Policy\RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Bridge.Contracts\RimGovernor.Brain.Bridge.Contracts.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.BuildingRuntime\RimGovernor.Brain.BuildingRuntime.csproj" />
    <ProjectReference Include="..\RimGovernor.Brain.Contracts\RimGovernor.Brain.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RimGovernor.Brain.Domain.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The wire messages share names with domain values (Identity, Failure); this project names the domain value and spells the wire message. -->
    <Using Include="RimGovernor.Brain.Bridge.Contracts.ObservationIdentity" Alias="ObservedIdentity" />
    <Using Include="RimGovernor.Contracts.Wire.Common.Identity" Alias="WireIdentity" />
  </ItemGroup>
</Project>
