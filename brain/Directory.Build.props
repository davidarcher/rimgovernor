<Project>
  <!-- Shared settings for the C# brain solution (epic #3043). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldDir>
  </PropertyGroup>
  <!-- Architecture gates (RGARCH001-008, docs/developers/architecture/rules.md): every src project loads the analyzers and
       gets the shrink-only baselines as AdditionalFiles. The analyzer project itself and the tests are not gated. The native mod build copies only the
       sources it ships, not the analyzers, so it skips the gate when the analyzer project is absent. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'RimGovernor.Brain.Analyzers' And !$(MSBuildProjectName.EndsWith('.Tests')) And Exists('$(MSBuildThisFileDirectory)analyzers/RimGovernor.Brain.Analyzers/RimGovernor.Brain.Analyzers.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/RimGovernor.Brain.Analyzers/RimGovernor.Brain.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)analyzers/baseline/*.txt" />
  </ItemGroup>
</Project>
