<Project>
  <!-- Shared settings for the C# brain solution (epic #3043). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldDir>
  </PropertyGroup>
  <!-- Architecture gates (RGARCH001-010, docs/developers/architecture/rules.md): every src project loads the analyzers and
       gets the shrink-only baselines as AdditionalFiles. The analyzer project itself and the tests are not gated. The native mod build copies only the
       sources it ships, not the analyzers, so it skips the gate when the analyzer project is absent. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'RimGovernor.Brain.Analyzers' And !$(MSBuildProjectName.EndsWith('.Tests')) And Exists('$(MSBuildThisFileDirectory)analyzers/RimGovernor.Brain.Analyzers/RimGovernor.Brain.Analyzers.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/RimGovernor.Brain.Analyzers/RimGovernor.Brain.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)analyzers/baseline/*.txt" />
  </ItemGroup>
  <!-- Charter rules 4 and 5 (#3397, #3410): RS0030 bans the APIs in analyzers/BannedSymbols.Acceptance.txt (wall-clock
       sleeps and JsonNode indexers) as an error in every acceptance project, harness and cases. The compiler writes
       banned-api.sarif; the gate's banned-API job fails a use a suppression kept from failing the build. -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('RimGovernor.Brain.Acceptance'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)analyzers/BannedSymbols.Acceptance.txt" />
  </ItemGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('RimGovernor.Brain.Acceptance'))">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <Target Name="BannedApiErrorLog" BeforeTargets="CoreCompile" Condition="$(MSBuildProjectName.StartsWith('RimGovernor.Brain.Acceptance'))">
    <PropertyGroup>
      <ErrorLog>$(IntermediateOutputPath)banned-api.sarif,version=2.1</ErrorLog>
    </PropertyGroup>
  </Target>
</Project>
