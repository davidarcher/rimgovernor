<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>RimGovernor.Brain.Domain.Tests</RootNamespace>
    <AssemblyName>RimGovernor.Brain.Domain.Tests</AssemblyName>
    <!-- The allocation-heavy portfolio tests run alongside each other; on the workstation GC they contend and the suite
         took about twice as long (45-55 s vs 25-34 s), for about 330 MB more peak memory. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Placement.WatchAccess" Alias="WatchAccess" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BuildingWind" Alias="BuildingWind" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.RoomRole" Alias="RoomRole" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.RouteTravel" Alias="RouteTravel" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.RouteFacilityKind" Alias="RouteFacilityKind" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.RoomState" Alias="RoomState" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.ClearanceFloor" Alias="ClearanceFloor" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.PawnRoyalHolding" Alias="PawnRoyalHolding" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BestowingCeremony" Alias="BestowingCeremony" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.AnomalyDoor" Alias="AnomalyDoor" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.EntityContainmentModeKind" Alias="EntityContainmentModeKind" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.GearClimate" Alias="GearClimate" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.GearSource" Alias="GearSource" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.Hediff" Alias="Hediff" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.HediffTend" Alias="HediffTend" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.HediffImmunity" Alias="HediffImmunity" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.ImmunityGain" Alias="ImmunityGain" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.SurgeryOperation" Alias="SurgeryOperation" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.SurgeryChance" Alias="SurgeryChance" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.SurgeryKind" Alias="SurgeryKind" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.SurgeryYield" Alias="SurgeryYield" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.MissingBodyPart" Alias="MissingBodyPart" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BodyPartRef" Alias="BodyPartRef" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.ColonyIdeology" Alias="ColonyIdeology" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.OwnedName" Alias="OwnedName" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <!-- Tests over the game's own Def types (Game/) compile only where the game install is present, as Game.props does. -->
  <PropertyGroup>
    <GameAssembly>$(RimWorldDir)/Assembly-CSharp.dll</GameAssembly>
    <GameAvailable Condition="Exists('$(GameAssembly)')">true</GameAvailable>
    <DefaultItemExcludes Condition="'$(GameAvailable)' != 'true'">$(DefaultItemExcludes);Game/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(GameAvailable)' == 'true'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)/Waylith.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath><Private>true</Private></Reference>
    <ProjectReference Include="../../src/RimGovernor.Brain.Bridge/RimGovernor.Brain.Bridge.csproj" />
    <!-- ThemePresetHoldableTests reads the install's Def XML (Data/<pack>/Defs). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>RimWorldDir</_Parameter1><_Parameter2>$(RimWorldDir)</_Parameter2></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../analyzers/RimGovernor.Brain.Analyzers/RimGovernor.Brain.Analyzers.csproj" />
    <ProjectReference Include="../../src/RimGovernor.Brain.Acceptance/RimGovernor.Brain.Acceptance.csproj" />
    <!-- The catalog test (AcceptanceCatalogTests) builds the whole case registry without a game. -->
    <ProjectReference Include="../../src/RimGovernor.Brain.Acceptance.Cases/RimGovernor.Brain.Acceptance.Cases.csproj" />
    <ProjectReference Include="../../src/RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
    <ProjectReference Include="../../src/RimGovernor.Brain.Host/RimGovernor.Brain.Host.csproj" />
    <!-- Remote acceptance aggregation (#3536) is game-free; its selection replay and attempt checks are pinned against the planner and suite writers. -->
    <ProjectReference Include="../../src/RimGovernor.Brain.RemoteAccept/RimGovernor.Brain.RemoteAccept.csproj" />
    <ProjectReference Include="../../src/RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
  </ItemGroup>
  <!-- The launcher is a WinExe outside this solution; its new-colony form and runner and the save loader (no WinForms dependency) are compiled in to pin the presets, the game reuse and the load retries. -->
  <ItemGroup>
    <Compile Include="../../../tools/launcher/NewColony.cs" Link="Launcher/NewColony.cs" />
    <Compile Include="../../../tools/launcher/LauncherException.cs" Link="Launcher/LauncherException.cs" />
    <Compile Include="../../../tools/launcher/SaveLoader.cs" Link="Launcher/SaveLoader.cs" />
    <Compile Include="../../../tools/launcher/NewColonyRunner.cs" Link="Launcher/NewColonyRunner.cs" />
    <Compile Include="../../../tools/launcher/Settings.cs" Link="Launcher/Settings.cs" />
    <Compile Include="../../../tools/launcher/LauncherJson.cs" Link="Launcher/LauncherJson.cs" />
  </ItemGroup>
  <!-- The launch waterfall's DeepProfiler label filter (#3308) is pure; compiled in to pin which RimWorld stages it skips. -->
  <ItemGroup>
    <Compile Include="../../../integrations/rimgovernor-host/src/Host/LaunchStageFilter.cs" Link="Host/LaunchStageFilter.cs" />
  </ItemGroup>
  <!-- Native's clock event row projection (#3415) reads only the wire event; compiled in to pin each row's kind and fields. -->
  <ItemGroup>
    <Compile Include="../../../integrations/rimgovernor-native/src/Bridge/Protocol/ColonyEventRows.cs" Link="Native/ColonyEventRows.cs" />
  </ItemGroup>
  <!-- The game-thread breadcrumb and the stall dump decision (#3576) are game-free; compiled in to pin the stall line and the one dump per process. -->
  <ItemGroup>
    <Compile Include="../../../integrations/rimgovernor-native/src/Bridge/Protocol/GameThreadStall.cs" Link="Native/GameThreadStall.cs" />
  </ItemGroup>
  <!-- The thoughtaudit guard analysis (#3218 spike) is pure syntax analysis; compiled in to pin its unknown handling without the game. -->
  <ItemGroup>
    <Compile Include="../../../tools/rg/Commands/ThoughtAudit/GuardIndex.cs" Link="ThoughtAudit/GuardIndex.cs" />
    <Compile Include="../../../tools/rg/Commands/ThoughtAudit/GuardAnalysis.cs" Link="ThoughtAudit/GuardAnalysis.cs" />
    <Compile Include="../../../tools/rg/Commands/ThoughtAudit/GuardCards.cs" Link="ThoughtAudit/GuardCards.cs" />
    <Compile Include="../../../tools/rg/Commands/ThoughtAudit/ThoughtDefs.cs" Link="ThoughtAudit/ThoughtDefs.cs" />
    <Compile Include="../../../tools/rg/Commands/ThoughtAudit/VerifiedCards.cs" Link="ThoughtAudit/VerifiedCards.cs" />
    <Compile Include="../../../tools/rg/Commands/ThoughtAudit/GuardTableCheck.cs" Link="ThoughtAudit/GuardTableCheck.cs" />
    <Compile Include="../../../tools/common/ToolException.cs" Link="ThoughtAudit/ToolException.cs" />
  </ItemGroup>
  <!-- The colony review's layout section (#3751) and the score it adds thresholds to are pure; compiled in to pin each metric and verdict. -->
  <ItemGroup>
    <Compile Include="../../../tools/rg/Commands/ColonyReview/LayoutReview.cs" Link="ColonyReview/LayoutReview.cs" />
    <Compile Include="../../../tools/rg/Commands/ColonyReview/ColonyScoring.cs" Link="ColonyReview/ColonyScoring.cs" />
    <Compile Include="../../../tools/rg/Commands/ColonyReview/ReviewModels.cs" Link="ColonyReview/ReviewModels.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Baselines/*.quality.json" LogicalName="RimGovernor.Brain.Domain.Tests.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodPlace" Alias="FoodPlace" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodConsumer" Alias="FoodConsumer" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodLarderFacts" Alias="FoodLarder" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodStock" Alias="FoodStock" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.CorpseHandling" Alias="CorpseHandling" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodIngredientClass" Alias="FoodIngredientClass" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodForm" Alias="FoodForm" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FoodRot" Alias="FoodRot" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Observations.ControlledEnvironment" Alias="ControlledEnvironment" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.GrowLight" Alias="GrowLight" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.PlantGrower" Alias="PlantGrower" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.GrowerFertility" Alias="GrowerFertility" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.GrowRoom" Alias="GrowRoom" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.PowerHeadroom" Alias="PowerHeadroom" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BuildingState" Alias="PowerSite" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BuildingState" Alias="PowerBuilding" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.TurretGun" Alias="TurretGun" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Observations.PowerNetwork" Alias="PowerNetworkFact" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.SteamGeyser" Alias="PowerGeyser" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BuildingState" Alias="FuelConsumer" />
    <Using Include="RimGovernor.Brain.GameFacts.Observations.FuelBurn" Alias="FuelBurn" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="RimGovernor.Brain.GameFacts.Observations.BuildingState" Alias="DefenseTurretFacts" />
  </ItemGroup>
  <ItemGroup><Using Include="RimGovernor.Brain.GameFacts.Observations.PenGrazing" Alias="PenGrazing" /></ItemGroup>
</Project>
