From: David Archer <darcher@gmail.com>
Date: Sun, 6 Sep 2026 00:12:24 -0400
Subject: [PATCH] Read the requested growing zone ID

---
 Contracts/rimapi.bundled.openapi.json                  | 10 +++++++++-
 Contracts/rimapi.openapi.json                          | 10 +++++++++-
 .../RimworldRestApi/Controllers/World/MapController.cs |  2 +-
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/Contracts/rimapi.bundled.openapi.json b/Contracts/rimapi.bundled.openapi.json
index a0fc2c2..7c29fe0 100644
--- a/Contracts/rimapi.bundled.openapi.json
+++ b/Contracts/rimapi.bundled.openapi.json
@@ -8766,6 +8766,14 @@
             "schema": {
               "type": "integer"
             }
+          },
+          {
+            "name": "zone_id",
+            "in": "query",
+            "required": true,
+            "schema": {
+              "type": "integer"
+            }
           }
         ],
         "x-native-collection-filters": true,
@@ -8773,7 +8781,7 @@
         "x-known-limitations": [
           "Handler passes map_id as zone_id."
         ],
-        "x-native-source-sha256": "3cc1886875d6e6423aa0f0f57ee59df1f46e0f740af6a9795e335c9620f5debe"
+        "x-native-source-sha256": "a9622df2f6dd8f3db90fb4d9c78cdad7346e4c9b879e4b57fcee1ab00d7a05de"
       },
       "post": {
         "operationId": "post_v1_map_zone_growing",
diff --git a/Contracts/rimapi.openapi.json b/Contracts/rimapi.openapi.json
index 88d63d1..a819c6c 100644
--- a/Contracts/rimapi.openapi.json
+++ b/Contracts/rimapi.openapi.json
@@ -8766,6 +8766,14 @@
             "schema": {
               "type": "integer"
             }
+          },
+          {
+            "name": "zone_id",
+            "in": "query",
+            "required": true,
+            "schema": {
+              "type": "integer"
+            }
           }
         ],
         "x-native-collection-filters": true,
@@ -8773,7 +8781,7 @@
         "x-known-limitations": [
           "Handler passes map_id as zone_id."
         ],
-        "x-native-source-sha256": "3cc1886875d6e6423aa0f0f57ee59df1f46e0f740af6a9795e335c9620f5debe"
+        "x-native-source-sha256": "a9622df2f6dd8f3db90fb4d9c78cdad7346e4c9b879e4b57fcee1ab00d7a05de"
       },
       "post": {
         "operationId": "post_v1_map_zone_growing",
diff --git a/Source/RIMAPI/RimworldRestApi/Controllers/World/MapController.cs b/Source/RIMAPI/RimworldRestApi/Controllers/World/MapController.cs
index d3756ee..738fc6c 100644
--- a/Source/RIMAPI/RimworldRestApi/Controllers/World/MapController.cs
+++ b/Source/RIMAPI/RimworldRestApi/Controllers/World/MapController.cs
@@ -120,7 +120,7 @@ namespace RIMAPI.Controllers
         public async Task GetMapGrowingZoneById(HttpListenerContext context)
         {
             var mapId = RequestParser.GetMapId(context);
-            var zoneId = RequestParser.GetMapId(context);
+            var zoneId = RequestParser.GetIntParameter(context, "zone_id");
             var result = _mapService.GetGrowingZoneById(mapId, zoneId);
             await context.SendJsonResponse(result);
         }
