diff --git a/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionWorkController.cs b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionWorkController.cs
new file mode 100644
index 0000000..ba09738
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionWorkController.cs
@@ -0,0 +1,90 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net;
+using System.Threading.Tasks;
+using RimWorld;
+using Verse;
+using Verse.AI;
+using RIMAPI.Core;
+using RIMAPI.Contracts;
+using RIMAPI.Helpers;
+
+namespace RIMAPI.Controllers
+{
+    public class ConstructionWorkController
+    {
+        private static List<int> Targets(Pawn pawn)
+        {
+            var job=pawn.CurJob;
+            if(job==null)return new List<int>();
+            var targets=new[]{job.targetA,job.targetB,job.targetC}.ToList();
+            if(job.targetQueueA!=null)targets.AddRange(job.targetQueueA);
+            if(job.targetQueueB!=null)targets.AddRange(job.targetQueueB);
+            return targets.Where(t=>t.HasThing).Select(t=>t.Thing.thingIDNumber).Distinct().ToList();
+        }
+        private static ConstructionWorkerCheck Check(Thing site,Pawn pawn)
+        {
+            var result=new ConstructionWorkerCheck{PawnId=pawn.thingIDNumber,CanConstruct=false,Reason=""};
+            if(pawn.Downed || pawn.Drafted || pawn.workSettings==null || pawn.WorkTypeIsDisabled(WorkTypeDefOf.Construction))
+            {result.Reason=pawn.Downed?"Downed":pawn.Drafted?"Drafted":"Construction disabled";return result;}
+            // Native checks write UI failure text. Restore it after observing.
+            string prior=JobFailReason.Reason,custom=JobFailReason.CustomJobString;bool silent=JobFailReason.Silent;
+            try
+            {
+                JobFailReason.Clear();
+                var blocking=GenConstruct.FirstBlockingThing(site,pawn);
+                result.BlockingThingId=blocking?.thingIDNumber;
+                if(site.IsForbidden(pawn)){result.Reason="Site forbidden for this pawn";return result;}
+                result.CanConstruct=GenConstruct.CanConstruct(site,pawn,WorkTypeDefOf.Construction);
+                result.Reason=result.CanConstruct?"":JobFailReason.Reason??(blocking!=null?"Blocked by "+blocking.LabelShort:"Native construction eligibility check rejected; no reason supplied");
+            }
+            finally {JobFailReason.Clear();if(prior!=null || custom!=null)JobFailReason.Is(prior,custom);if(silent)JobFailReason.IsSilent();}
+            return result;
+        }
+        [Get("/api/v1/map/construction-work")]
+        public async Task Read(HttpListenerContext context)
+        {
+            try
+            {
+                var q=context.Request.QueryString;int mid,offset=0,limit=16;
+                if(!int.TryParse(q["map_id"],out mid))throw new ArgumentException("map_id is required.");
+                if(q["offset"]!=null&&!int.TryParse(q["offset"],out offset))throw new ArgumentException("offset must be an integer.");
+                if(q["limit"]!=null&&!int.TryParse(q["limit"],out limit))throw new ArgumentException("limit must be an integer.");
+                if(offset<0||limit<1||limit>32)throw new ArgumentException("offset >= 0; limit must be 1..32.");
+                var map=MapHelper.GetMapByID(mid);if(map==null)throw new ArgumentException("Map not found.");
+                var pawns=map.mapPawns.FreeColonistsSpawned.Where(p=>!p.Dead).ToList();
+                var workers=pawns.Select(p=>new ConstructionWorkerObservation{PawnId=p.thingIDNumber,Name=p.LabelShort,Idle=p.mindState.IsIdle,Drafted=p.Drafted,Downed=p.Downed,ConstructionPriority=p.workSettings?.GetPriority(WorkTypeDefOf.Construction)??0,CurrentJob=p.CurJob?.def.defName??"",TargetIds=Targets(p)}).ToList();
+                var sites=map.listerThings.ThingsInGroup(ThingRequestGroup.Blueprint).Concat(map.listerThings.ThingsInGroup(ThingRequestGroup.BuildingFrame))
+                    .Where(t=>(t is Blueprint_Build || t is Frame)&&t.Faction==Faction.OfPlayer&&!t.Position.Fogged(map)).OrderBy(t=>t.thingIDNumber).ToList();
