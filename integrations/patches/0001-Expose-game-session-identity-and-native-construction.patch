From 9a91b3b9341760f805d410cc9f666a747ce094dc Mon Sep 17 00:00:00 2001
From: David Archer <darcher@gmail.com>
Date: Sat, 5 Sep 2026 16:32:04 -0400
Subject: [PATCH] Expose game session identity and native construction
 materials

---
 .../Core/Caching/CachingService.cs                |  3 +++
 .../RimworldRestApi/Helpers/GamePlayHelper.cs     | 14 +++++++++++++-
 .../RimworldRestApi/Models/Game/GameStateDto.cs   |  1 +
 .../RimworldRestApi/Models/Items/ItemsDto.cs      |  7 +++++++
 .../World/BuilderService/BuilderService.cs        | 15 ++++++++++++++-
 5 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/Source/RIMAPI/RimworldRestApi/Core/Caching/CachingService.cs b/Source/RIMAPI/RimworldRestApi/Core/Caching/CachingService.cs
index 4b565f4..52498b0 100644
--- a/Source/RIMAPI/RimworldRestApi/Core/Caching/CachingService.cs
+++ b/Source/RIMAPI/RimworldRestApi/Core/Caching/CachingService.cs
@@ -444,6 +444,9 @@ namespace RIMAPI.Core
         {
             try
             {
+                // Scope cached observations to the actual loaded Game instance.
+                // Capture before awaiting so an old request cannot fill a new game's cache.
+                cacheKey = RIMAPI.Helpers.GamePlayHelper.SessionId + ":" + cacheKey;
                 // Try to get from cache
                 if (TryGet(cacheKey, out ApiResult<T> cachedResult))
                 {
diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs
index 55d2ff1..4a74483 100644
--- a/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs
@@ -11,6 +11,17 @@ namespace RIMAPI.Helpers
 {
     public static class GamePlayHelper
     {
+        private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<Game, Session> Sessions =
+            new System.Runtime.CompilerServices.ConditionalWeakTable<Game, Session>();
+        private sealed class Session
+        {
+            public readonly string Id = Guid.NewGuid().ToString("N");
+        }
+
+        // Map seeds and numeric IDs are reused by quicktest and save loading.
+        public static string SessionId => Current.Game == null ? null :
+            Sessions.GetValue(Current.Game, _ => new Session()).Id;
+
         public static void InitGameFromConfiguration(NewGameStartRequestDto request)
         {
             StorytellerDef storytellerDef = DefDatabase<StorytellerDef>.GetNamed(request.StorytellerName);
@@ -80,6 +91,7 @@ namespace RIMAPI.Helpers
         public static GameStateDto GetGameStateDto()
         {
             var state = new GameStateDto();
+            state.SessionId = SessionId;
 
             try
             {
@@ -248,4 +260,4 @@ namespace RIMAPI.Helpers
         }
     }
 
-}
\ No newline at end of file
+}
diff --git a/Source/RIMAPI/RimworldRestApi/Models/Game/GameStateDto.cs b/Source/RIMAPI/RimworldRestApi/Models/Game/GameStateDto.cs
index 6d7f214..384d257 100644
--- a/Source/RIMAPI/RimworldRestApi/Models/Game/GameStateDto.cs
+++ b/Source/RIMAPI/RimworldRestApi/Models/Game/GameStateDto.cs
@@ -2,6 +2,7 @@ namespace RIMAPI.Models
 {
     public class GameStateDto
     {
+        public string SessionId { get; set; }
         public int GameTick { get; set; }
         public float ColonyWealth { get; set; }
         public int ColonistCount { get; set; }
diff --git a/Source/RIMAPI/RimworldRestApi/Models/Items/ItemsDto.cs b/Source/RIMAPI/RimworldRestApi/Models/Items/ItemsDto.cs
index d29b6ab..3b1a5bd 100644
--- a/Source/RIMAPI/RimworldRestApi/Models/Items/ItemsDto.cs
+++ b/Source/RIMAPI/RimworldRestApi/Models/Items/ItemsDto.cs
@@ -34,6 +34,9 @@ namespace RIMAPI.Models
         public string TechLevel { get; set; }
         public List<string> TradeTags { get; set; }
         public List<string> StuffCategories { get; set; }
+        public bool MadeFromStuff { get; set; }
+        public int CostStuffCount { get; set; }
+        public List<string> AllowedStuffDefs { get; set; }
         public float MaxHealth { get; set; }
         public float ArmorRating_Sharp { get; set; }
         public float ArmorRating_Blunt { get; set; }
@@ -64,6 +67,10 @@ namespace RIMAPI.Models
                 IsPawn = thing.category == ThingCategory.Pawn,
                 IsPlant = thing.category == ThingCategory.Plant,
                 IsBuilding = thing.category == ThingCategory.Building,
+                MadeFromStuff = thing.MadeFromStuff,
+                CostStuffCount = thing.costStuffCount,
+                StuffCategories = thing.stuffCategories?.Select(s => s.defName).ToList(),
+                AllowedStuffDefs = thing.MadeFromStuff ? GenStuff.AllowedStuffsFor(thing).Select(s => s.defName).ToList() : null,
                 IsMedicine = thing.IsMedicine,
                 IsDrug = thing.IsDrug,
                 MarketValue = thing.BaseMarketValue,
diff --git a/Source/RIMAPI/RimworldRestApi/Services/World/BuilderService/BuilderService.cs b/Source/RIMAPI/RimworldRestApi/Services/World/BuilderService/BuilderService.cs
index 4c0066b..6534590 100644
--- a/Source/RIMAPI/RimworldRestApi/Services/World/BuilderService/BuilderService.cs
+++ b/Source/RIMAPI/RimworldRestApi/Services/World/BuilderService/BuilderService.cs
@@ -175,6 +175,19 @@ namespace RIMAPI.Services
                 var map = MapHelper.GetMapByID(request.MapId);
                 if (map == null) return ApiResult.Fail($"Map {request.MapId} not found.");
 
+                // Validate the whole building batch before placing any part of it.
+                foreach (var building in request.Blueprint.Buildings)
+                {
+                    var def = DefDatabase<ThingDef>.GetNamedSilentFail(building.DefName);
+                    if (def == null) return ApiResult.Fail($"Unknown building: {building.DefName}");
+                    var stuff = string.IsNullOrEmpty(building.StuffDefName) ? null :
+                        DefDatabase<ThingDef>.GetNamedSilentFail(building.StuffDefName);
+                    if (def.MadeFromStuff && (stuff == null || !GenStuff.AllowedStuffsFor(def).Contains(stuff)))
+                        return ApiResult.Fail($"{def.defName} requires stuff_def_name from: {string.Join(", ", GenStuff.AllowedStuffsFor(def).Select(s => s.defName))}");
+                    if (!def.MadeFromStuff && !string.IsNullOrEmpty(building.StuffDefName))
+                        return ApiResult.Fail($"{def.defName} does not use stuff_def_name.");
+                }
+
                 int anchorX = request.Position.X;
                 int anchorZ = request.Position.Z;
                 int count = 0;
@@ -350,4 +363,4 @@ namespace RIMAPI.Services
             }
         }
     }
-}
\ No newline at end of file
+}
