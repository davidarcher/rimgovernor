diff --git a/Source/RIMAPI/RimworldRestApi/Controllers/Pawns/WorkSettingsController.cs b/Source/RIMAPI/RimworldRestApi/Controllers/Pawns/WorkSettingsController.cs
new file mode 100644
index 0000000..e41c50a
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Controllers/Pawns/WorkSettingsController.cs
@@ -0,0 +1,51 @@
+using System;
+using System.IO;
+using System.Net;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using RimWorld;
+using Verse;
+using RIMAPI.Contracts;
+using RIMAPI.Core;
+
+namespace RIMAPI.Controllers
+{
+    public class WorkSettingsController
+    {
+        private static WorkSettings Read()
+        {
+            if(Current.Game?.playSettings==null) throw new ArgumentException("Load a colony before changing work settings.");
+            return new WorkSettings { UseWorkPriorities=Current.Game.playSettings.useWorkPriorities };
+        }
+        [Get("/api/v1/work/settings")]
+        public Task GetWorkSettings(HttpListenerContext context) => Handle(context,false);
+        [Post("/api/v1/work/settings")]
+        public Task SetWorkSettings(HttpListenerContext context) => Handle(context,true);
+        private async Task Handle(HttpListenerContext context,bool write)
+        {
+            try
+            {
+                var current=Read();
+                if(write)
+                {
+                    string body;using(var reader=new StreamReader(context.Request.InputStream))body=await reader.ReadToEndAsync();
+                    var token=JToken.Parse(body);WireContract.Validate(token,WireContract.Schema(typeof(WorkSettings)));
+                    var requested=token.ToObject<WorkSettings>();
+                    if(requested.UseWorkPriorities!=current.UseWorkPriorities)
+                    {
+                        // Same setting and invalidation as MainTabWindow_Work.DoWindowContents.
+                        Current.Game.playSettings.useWorkPriorities=requested.UseWorkPriorities;
+                        foreach(var pawn in PawnsFinder.AllMapsWorldAndTemporary_Alive)
+                            if(pawn.Faction==Faction.OfPlayer && pawn.workSettings!=null)
+                                pawn.workSettings.Notify_UseWorkPrioritiesChanged();
+                    }
+                }
+                await WireContract.Send(context,Read(),typeof(WorkSettings));
+            }
+            catch(JsonException e) { await WireContract.Send(context,new ContractError{Code="contract_violation",Message=e.Message},typeof(ContractError),400); }
+            catch(ArgumentException e) { await WireContract.Send(context,new ContractError{Code="invalid_request",Message=e.Message},typeof(ContractError),400); }
+            catch(Exception e) { await WireContract.Send(context,new ContractError{Code="execution_error",Message=e.Message},typeof(ContractError),500); }
+        }
+    }
+}
