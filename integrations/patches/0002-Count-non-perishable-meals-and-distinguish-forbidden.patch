From 6fd4576c73ea9eb710d958afb63e3aa018152fe1 Mon Sep 17 00:00:00 2001
From: David Archer <darcher@gmail.com>
Date: Sat, 5 Sep 2026 17:04:18 -0400
Subject: [PATCH] Count non-perishable meals and distinguish forbidden
 nutrition

---
 .../Helpers/ResourcesHelper.cs                | 36 ++++++-------------
 .../Models/Items/ResourcesDto.cs              |  2 ++
 2 files changed, 12 insertions(+), 26 deletions(-)

diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/ResourcesHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/ResourcesHelper.cs
index 731d174..557c2a0 100644
--- a/Source/RIMAPI/RimworldRestApi/Helpers/ResourcesHelper.cs
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/ResourcesHelper.cs
@@ -61,31 +61,17 @@ namespace RIMAPI.Helpers
 
         public static ResourcesFoodSummaryDto GetResourcesFoodSummary(Map map, List<Thing> allItems)
         {
-            ResourcesFoodSummaryDto summaryDto = new ResourcesFoodSummaryDto();
-
-            var foodItems = allItems.Where(t => t.def.IsNutritionGivingIngestible).ToList();
-            summaryDto.FoodTotal = foodItems.Sum(t => t.stackCount);
-
-            float totalNutrition = map.resourceCounter.TotalHumanEdibleNutrition;
-            int colonistCount =
-                map.mapPawns.FreeColonistsSpawnedCount + map.mapPawns.PrisonersOfColonyCount;
-            int daysOfFood = Mathf.FloorToInt(totalNutrition / colonistCount);
-
-            summaryDto.TotalNutrition = foodItems.Sum(f => GetFoodNutrition(f));
-            var dto = new ResourcesFoodSummaryDto
+            var foodItems = allItems.Where(t => t.def.IsNutritionGivingIngestible && t.def.ingestible.HumanEdible).ToList();
+            return new ResourcesFoodSummaryDto
             {
-                FoodTotal = allItems.Count(t => t.def.IsNutritionGivingIngestible),
-                TotalNutrition = map.resourceCounter.TotalHumanEdibleNutrition,
-                MealsCount = allItems.Count(t =>
-                    t.def.IsNutritionGivingIngestible && t.def.ingestible.IsMeal
-                ),
-                RawFoodCount = allItems.Count(t =>
-                    t.def.IsNutritionGivingIngestible && !t.def.ingestible.IsMeal
-                ),
+                FoodTotal = foodItems.Sum(t => t.stackCount),
+                TotalNutrition = foodItems.Sum(GetFoodNutrition),
+                UnforbiddenNutrition = foodItems.Where(t => !t.IsForbidden(Faction.OfPlayer)).Sum(GetFoodNutrition),
+                ForbiddenNutrition = foodItems.Where(t => t.IsForbidden(Faction.OfPlayer)).Sum(GetFoodNutrition),
+                MealsCount = foodItems.Where(t => t.def.ingestible.IsMeal).Sum(t => t.stackCount),
+                RawFoodCount = foodItems.Where(t => !t.def.ingestible.IsMeal).Sum(t => t.stackCount),
                 RotStatusInfo = GetFoodRotStatusInfo(map, allItems),
             };
-
-            return summaryDto;
         }
 
         public static RotStatusInfoDto GetFoodRotStatusInfo(Map map, List<Thing> allItems)
@@ -164,11 +150,9 @@ namespace RIMAPI.Helpers
 
         public static float GetFoodNutrition(Thing food)
         {
-            CompRottable comp = food.TryGetComp<CompRottable>();
-
-            if (comp != null && comp.PropsRot.daysToRotStart > 0 && food.def.ingestible.HumanEdible)
+            if (food.def.ingestible != null && food.def.ingestible.HumanEdible)
             {
-                return food.stackCount * food.def.GetStatValueAbstract(StatDefOf.Nutrition);
+                return food.stackCount * food.GetStatValue(StatDefOf.Nutrition);
             }
             return 0f;
         }
diff --git a/Source/RIMAPI/RimworldRestApi/Models/Items/ResourcesDto.cs b/Source/RIMAPI/RimworldRestApi/Models/Items/ResourcesDto.cs
index b08155d..510a63a 100644
--- a/Source/RIMAPI/RimworldRestApi/Models/Items/ResourcesDto.cs
+++ b/Source/RIMAPI/RimworldRestApi/Models/Items/ResourcesDto.cs
@@ -36,6 +36,8 @@ namespace RIMAPI.Models
 
     public class ResourcesFoodSummaryDto
     {
+        public float UnforbiddenNutrition { get; set; }
+        public float ForbiddenNutrition { get; set; }
         public int FoodTotal { get; set; }
         public float TotalNutrition { get; set; }
         public int MealsCount { get; set; }
-- 
