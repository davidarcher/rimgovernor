diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs
index 4a74483..e874309 100644
--- a/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/GamePlayHelper.cs
@@ -1,6 +1,7 @@
 
 
 using System;
+using System.Linq;
 using RIMAPI.Models;
 using RimWorld;
 using UnityEngine;
@@ -22,8 +23,25 @@ namespace RIMAPI.Helpers
         public static string SessionId => Current.Game == null ? null :
             Sessions.GetValue(Current.Game, _ => new Session()).Id;
 
+        public static Scenario StartingScenario(NewGameStartRequestDto request)
+        {
+            var definition=DefDatabase<ScenarioDef>.GetNamedSilentFail(request.ScenarioDefName??ScenarioDefOf.Crashlanded.defName);
+            if(definition==null)throw new ArgumentException("Unknown scenario definition.");
+            var scenario=definition.scenario.CopyForEditing();
+            if(request.StartingPawnCount.HasValue)
+            {
+                int count=request.StartingPawnCount.Value;
+                if(count<1 || count>10)throw new ArgumentException("Starting pawn count must be 1..10, matching the native scenario editor.");
+                var pawns=scenario.AllParts.OfType<ScenPart_ConfigPage_ConfigureStartingPawns>().SingleOrDefault();
+                if(pawns==null)throw new ArgumentException("This scenario has no configurable starting pawn count.");
+                pawns.pawnCount=count;
+            }
+            return scenario;
+        }
+
         public static void InitGameFromConfiguration(NewGameStartRequestDto request)
         {
+            var scenario=StartingScenario(request);
             StorytellerDef storytellerDef = DefDatabase<StorytellerDef>.GetNamed(request.StorytellerName);
             DifficultyDef difficultyDef = DefDatabase<DifficultyDef>.GetNamed(request.DifficultyName);
 
@@ -37,7 +55,7 @@ namespace RIMAPI.Helpers
 #endif
             Current.Game = new Game();
             Current.Game.InitData = new GameInitData();
-            Current.Game.Scenario = ScenarioDefOf.Crashlanded.scenario;
+            Current.Game.Scenario = scenario;
             Find.Scenario.PreConfigure();
             Current.Game.storyteller = new Storyteller(storytellerDef, difficultyDef);
             GameInitData initData = Find.GameInitData;
