diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/ZonePlacementHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/ZonePlacementHelper.cs
new file mode 100644
index 0000000..42b02f0
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/ZonePlacementHelper.cs
@@ -0,0 +1,34 @@
+using System.Collections.Generic;
+using System.Linq;
+using RimWorld;
+using Verse;
+
+namespace RIMAPI.Helpers
+{
+    internal static class ZonePlacementHelper
+    {
+        // Preflight the entire request before registration: failed calls create nothing.
+        public static string ValidateNewZone(Map map, IEnumerable<IntVec3> cells)
+        {
+            foreach (var cell in cells)
+            {
+                var report = Designator_ZoneAdd.IsZoneableCell(cell, map);
+                if (!report.Accepted)
+                {
+                    var blocker = cell.InBounds(map)
+                        ? map.thingGrid.ThingsAt(cell).FirstOrDefault(t => !t.def.CanOverlapZones)
+                        : null;
+                    var reason = blocker != null ? $"blocked by {blocker.ThingID} ({blocker.def.defName})"
+                        : !cell.InBounds(map) ? "out of bounds"
+                        : cell.Fogged(map) ? "unexplored"
+                        : !string.IsNullOrEmpty(report.Reason) ? report.Reason : "not zoneable";
+                    return $"Cannot create zone at ({cell.x}, {cell.z}): {reason}. No zone was created.";
+                }
+                var zone = map.zoneManager.ZoneAt(cell);
+                if (zone != null)
+                    return $"Cannot create zone at ({cell.x}, {cell.z}): already in zone {zone.ID} ({zone.label}). No zone was created.";
+            }
+            return null;
+        }
+    }
+}
