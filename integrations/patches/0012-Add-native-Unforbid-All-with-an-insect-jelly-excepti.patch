diff --git a/Source/RIMAPI/RimworldRestApi/Controllers/Colony/SupplyOrdersController.cs b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/SupplyOrdersController.cs
new file mode 100644
index 0000000..c43c2bc
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/SupplyOrdersController.cs
@@ -0,0 +1,53 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using RIMAPI.Contracts;
+using RIMAPI.Core;
+using RIMAPI.Helpers;
+using RimWorld;
+using Verse;
+
+namespace RIMAPI.Controllers
+{
+    // The native Allow designator with one explicit bulk-action exception.
+    public class SupplyOrdersController
+    {
+        [Post("/api/v2/orders/unforbid-all")]
+        public Task AllowAll(HttpListenerContext context) => Handle(context, true);
+
+        [Post("/api/v2/orders/forbidden-overview")]
+        public Task Overview(HttpListenerContext context) => Handle(context, false);
+
+        private static async Task Handle(HttpListenerContext context, bool apply)
+        {
+            try
+            {
+                string body;
+                using (var reader = new StreamReader(context.Request.InputStream)) body = await reader.ReadToEndAsync();
+                var token = JToken.Parse(body);
+                WireContract.Validate(token, WireContract.Schema(typeof(AllowAllRequest)));
+                var request = token.ToObject<AllowAllRequest>(JsonSerializer.Create(WireContract.Settings));
+                var map = MapHelper.GetMapByID(request.MapId);
+                if (map == null) throw new ArgumentException("Map not found.");
+                var designator = new Designator_Unforbid();
+                var candidates = map.listerThings.AllThings.Where(t => t.Spawned && !t.Position.Fogged(map) && designator.CanDesignateThing(t).Accepted).ToList();
+                var exempt = candidates.Count(t => t.def == ThingDefOf.InsectJelly);
+                var eligible = candidates.Where(t => t.def != ThingDefOf.InsectJelly).ToList();
+                if (apply)
+                    foreach (var thing in eligible) designator.DesignateThing(thing);
+                var remaining = eligible.Count(t => designator.CanDesignateThing(t).Accepted);
+                await WireContract.Send(context, new AllowAllResult {
+                    MapId = request.MapId, ChangedCount = apply ? eligible.Count - remaining : 0,
+                    ExcludedJellyCount = exempt, RemainingEligibleCount = remaining
+                }, typeof(AllowAllResult));
+            }
+            catch (JsonException error) { await WireContract.Send(context, new ContractError { Code="contract_violation", Message=error.Message }, typeof(ContractError), 400); }
+            catch (ArgumentException error) { await WireContract.Send(context, new ContractError { Code="invalid_request", Message=error.Message }, typeof(ContractError), 400); }
+            catch (Exception error) { await WireContract.Send(context, new ContractError { Code="execution_error", Message=error.Message }, typeof(ContractError), 500); }
+        }
+    }
+}
