diff --git a/Source/RIMAPI/RimworldRestApi/Contracts/HttpNativeModels.g.cs b/Source/RIMAPI/RimworldRestApi/Contracts/HttpNativeModels.g.cs
index dba4527..a3435fe 100644
--- a/Source/RIMAPI/RimworldRestApi/Contracts/HttpNativeModels.g.cs
+++ b/Source/RIMAPI/RimworldRestApi/Contracts/HttpNativeModels.g.cs
@@ -79,6 +79,8 @@ namespace RIMAPI.Contracts
         [JsonProperty("nearby_forbidden_quantity")] public int NearbyForbiddenQuantity { get; set; }
         [JsonProperty("nutrition_per_unit")] public float NutritionPerUnit { get; set; }
         [JsonProperty("location")] public ResourceLocation Location { get; set; }
+        [JsonProperty("material_categories")] public List<string> MaterialCategories { get; set; }
+        [JsonProperty("food_type")] public string FoodType { get; set; }
     }
     public sealed class CropResource
     {
diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs
index 660249b..2fc9b72 100644
--- a/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs
@@ -119,7 +119,7 @@ namespace RIMAPI.Helpers
             foreach(var group in map.listerThings.ThingsInGroup(ThingRequestGroup.HaulableEver).Where(t=>t.def.category==ThingCategory.Item && Visible(t,map)).GroupBy(t=>t.def))
             {
                 var items=group.ToList();var allowed=items.Where(t=>!t.IsForbidden(Faction.OfPlayer)).ToList();var forbidden=items.Where(t=>t.IsForbidden(Faction.OfPlayer)).ToList();
-                result.Supplies.Add(new SupplyResource{DefName=group.Key.defName,Label=group.Key.label??group.Key.defName,Quantity=items.Sum(t=>t.stackCount),AllowedQuantity=allowed.Sum(t=>t.stackCount),ForbiddenQuantity=forbidden.Sum(t=>t.stackCount),NearbyAllowedQuantity=allowed.Where(t=>Distance(t.Position,center)<=radius).Sum(t=>t.stackCount),NearbyForbiddenQuantity=forbidden.Where(t=>Distance(t.Position,center)<=radius).Sum(t=>t.stackCount),NutritionPerUnit=Nutrition(group.Key),Location=Location(items,center,radius)});
+                result.Supplies.Add(new SupplyResource{DefName=group.Key.defName,Label=group.Key.label??group.Key.defName,Quantity=items.Sum(t=>t.stackCount),AllowedQuantity=allowed.Sum(t=>t.stackCount),ForbiddenQuantity=forbidden.Sum(t=>t.stackCount),NearbyAllowedQuantity=allowed.Where(t=>Distance(t.Position,center)<=radius).Sum(t=>t.stackCount),NearbyForbiddenQuantity=forbidden.Where(t=>Distance(t.Position,center)<=radius).Sum(t=>t.stackCount),MaterialCategories=group.Key.stuffProps?.categories?.Select(c=>c.defName).ToList()??new List<string>(),FoodType=group.Key.ingestible?.foodType.ToString()??"",NutritionPerUnit=Nutrition(group.Key),Location=Location(items,center,radius)});
             }
             foreach(var def in DefDatabase<ThingDef>.AllDefsListForReading.Where(d=>d.plant?.sowTags!=null && d.plant.sowTags.Contains("Ground") && Nutrition(d.plant.harvestedThingDef)>0))
             {
