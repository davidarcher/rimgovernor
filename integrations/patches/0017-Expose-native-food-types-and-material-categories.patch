 4 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/Contracts/rimapi.bundled.openapi.json b/Contracts/rimapi.bundled.openapi.json
index e3576e1..dc867c7 100644
--- a/Contracts/rimapi.bundled.openapi.json
+++ b/Contracts/rimapi.bundled.openapi.json
@@ -30215,6 +30215,15 @@
           },
           "location": {
             "$ref": "#/components/schemas/ResourceLocation"
+          },
+          "material_categories": {
+            "type": "array",
+            "items": {
+              "type": "string"
+            }
+          },
+          "food_type": {
+            "type": "string"
           }
         },
         "required": [
@@ -30226,7 +30235,9 @@
           "nearby_allowed_quantity",
           "nearby_forbidden_quantity",
           "nutrition_per_unit",
-          "location"
+          "location",
+          "material_categories",
+          "food_type"
         ],
         "additionalProperties": false,
         "x-generate-csharp": true
