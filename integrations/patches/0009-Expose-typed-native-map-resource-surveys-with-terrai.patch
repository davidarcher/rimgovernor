diff --git a/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ResourceOverviewController.cs b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ResourceOverviewController.cs
new file mode 100644
index 0000000..daedbb6
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ResourceOverviewController.cs
@@ -0,0 +1,30 @@
+using System;
+using System.Net;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using RIMAPI.Core;
+using RIMAPI.Contracts;
+using RIMAPI.Helpers;
+using Verse;
+namespace RIMAPI.Controllers
+{
+    public class ResourceOverviewController
+    {
+        [Get("/api/v1/map/resource-overview")]
+        public async Task Overview(HttpListenerContext context)
+        {
+            try
+            {
+                var query=context.Request.QueryString;
+                int mapId,x,z,radius=40;bool refresh=false;
+                if(!int.TryParse(query["map_id"],out mapId)||!int.TryParse(query["center_x"],out x)||!int.TryParse(query["center_z"],out z))throw new ArgumentException("map_id, center_x and center_z are required integers.");
+                if(query["nearby_radius"]!=null && !int.TryParse(query["nearby_radius"],out radius))throw new ArgumentException("nearby_radius must be an integer.");
+                if(query["refresh_terrain"]!=null && !bool.TryParse(query["refresh_terrain"],out refresh))throw new ArgumentException("refresh_terrain must be a boolean.");
+                var result=ResourceOverviewHelper.Read(MapHelper.GetMapByID(mapId),new IntVec3(x,0,z),radius,refresh);
+                await WireContract.Send(context,result,typeof(MapResourceOverview));
+            }
+            catch(ArgumentException e){await WireContract.Send(context,new ContractError{Code="invalid_request",Message=e.Message},typeof(ContractError),400);}
+            catch(Exception e){await WireContract.Send(context,new ContractError{Code="execution_error",Message=e.Message},typeof(ContractError),500);}
+        }
+    }
+}
diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs
new file mode 100644
index 0000000..660249b
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/ResourceOverviewHelper.cs
@@ -0,0 +1,155 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Runtime.CompilerServices;
+using System.Threading;
+using HarmonyLib;
+using RimWorld;
+using Verse;
+using RIMAPI.Contracts;
+
+namespace RIMAPI.Helpers
+{
+    public static class ResourceOverviewHelper
+    {
+        private const int TerrainMaxAge=2500;
+#if RIMWORLD_1_6
+        // Public property added after the reference assembly version; absence is unknown, not false.
+        private static readonly System.Reflection.PropertyInfo FrozenProperty=typeof(WaterBody).GetProperty("TotallyFrozen");
+#endif
+        private static int terrainEpoch;
+        private sealed class TerrainSnapshot
+        {
+            public int Tick,Epoch,Visible;
+            public TerrainDef[] Cells;
+            public readonly Dictionary<string,List<TerrainResource>> Summaries=new Dictionary<string,List<TerrainResource>>();
+        }
+        private static readonly ConditionalWeakTable<Map,TerrainSnapshot> TerrainCaches=new ConditionalWeakTable<Map,TerrainSnapshot>();
+        public static void InvalidateTerrain() { Interlocked.Increment(ref terrainEpoch); }
+        private static ResourceCell Cell(IntVec3 c) => new ResourceCell{X=c.x,Z=c.z};
+        private static float Distance(IntVec3 a,IntVec3 b) => (float)Math.Sqrt((a.x-b.x)*(a.x-b.x)+(a.z-b.z)*(a.z-b.z));
+        private static bool Visible(Thing t,Map map) => t.Spawned && t.Map==map && !t.Position.Fogged(map);
+        private static ResourceLocation Location(List<Thing> things,IntVec3 center,int radius)
+        {
+            var ordered=things.OrderBy(t=>Distance(t.Position,center)).ThenBy(t=>t.thingIDNumber).ToList();
+            return new ResourceLocation{NearbyCount=ordered.Count(t=>Distance(t.Position,center)<=radius),NearestCell=Cell(ordered[0].Position),NearestDistance=Distance(ordered[0].Position,center),SampleIds=ordered.Take(3).Select(t=>t.thingIDNumber).ToList()};
+        }
+        private static TerrainSnapshot Terrain(Map map,bool refresh,out bool hit)
+        {
+            int tick=Find.TickManager.TicksGame;
+            var cached=TerrainCaches.GetValue(map,_=>new TerrainSnapshot());
+            hit=!refresh && cached.Cells!=null && cached.Epoch==terrainEpoch && tick>=cached.Tick && tick-cached.Tick<TerrainMaxAge;
+            if(hit)return cached;
+            cached.Cells=new TerrainDef[map.Size.x*map.Size.z];cached.Visible=0;cached.Summaries.Clear();
+            foreach(var cell in map.AllCells)
+            {
+                if(cell.Fogged(map))continue;
+                cached.Cells[map.cellIndices.CellToIndex(cell)]=map.terrainGrid.TerrainAt(cell);cached.Visible++;
+            }
+            cached.Tick=tick;cached.Epoch=terrainEpoch;return cached;
+        }
+        private static List<TerrainResource> TerrainRows(Map map,TerrainSnapshot terrain,IntVec3 center,int radius)
+        {
+            string key=center.x+":"+center.z+":"+radius;
+            if(terrain.Summaries.TryGetValue(key,out var saved))return saved;
+            int width=map.Size.x;
+            var rows=new Dictionary<TerrainDef,TerrainResource>();
+            var nearby=new bool[terrain.Cells.Length];
+            for(int i=0;i<terrain.Cells.Length;i++)
+            {
+                var def=terrain.Cells[i];if(def==null)continue;
+                var cell=new IntVec3(i%width,0,i/width);float distance=Distance(cell,center);
+                if(!rows.TryGetValue(def,out var row))
+                {
+                    row=new TerrainResource{DefName=def.defName,Label=def.label??def.defName,Fertility=def.fertility,NearestDistance=distance,NearestCell=Cell(cell)};rows.Add(def,row);
+                }
+                row.VisibleCells++;if(distance<row.NearestDistance){row.NearestDistance=distance;row.NearestCell=Cell(cell);}
+                if(distance<=radius){row.NearbyCells++;nearby[i]=true;}
+            }
+            // Four-connected patches of the same native terrain, clipped to the
+            // requested radius. These are fertility candidates, not approved zones.
+            var queue=new Queue<int>();
+            for(int start=0;start<nearby.Length;start++)
+            {
+                if(!nearby[start])continue;
+                var def=terrain.Cells[start];int size=0;queue.Enqueue(start);nearby[start]=false;
+                while(queue.Count>0)
+                {
+                    int i=queue.Dequeue();size++;int x=i%width;
+                    foreach(int next in new[]{x>0?i-1:-1,x<width-1?i+1:-1,i-width,i+width})
