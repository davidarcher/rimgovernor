diff --git a/Source/RIMAPI/RimworldRestApi/Helpers/FoodAccessHelper.cs b/Source/RIMAPI/RimworldRestApi/Helpers/FoodAccessHelper.cs
new file mode 100644
index 0000000..adc8adc
--- /dev/null
+++ b/Source/RIMAPI/RimworldRestApi/Helpers/FoodAccessHelper.cs
@@ -0,0 +1,39 @@
+using System.Collections.Generic;
+using System.Linq;
+using RIMAPI.Contracts;
+using RimWorld;
+using Verse;
+using Verse.AI;
+
+namespace RIMAPI.Helpers
+{
+    public static class FoodAccessHelper
+    {
+        public static FoodAccess Observe(Map map, List<Thing> items)
+        {
+            var pawns = map.mapPawns.FreeColonistsSpawned.Where(p => !p.Dead && p.needs?.food != null).OrderBy(p => p.thingIDNumber).ToList();
+            var result = new FoodAccess { ObservedTick = Find.TickManager.TicksGame,
+                Consumers = pawns.Select(p => new FoodConsumer { PawnId = p.thingIDNumber,
+                    NutritionPerDay = p.needs.food.FoodFallPerTickAssumingCategory(HungerCategory.Fed, true) * 60000f }).ToList(),
+                Pools = new List<FoodPool>() };
+            var pools = new Dictionary<string, FoodPool>();
+            foreach (var item in items)
+            {
+                if (!item.Spawned || item.Position.Fogged(map) || !item.IngestibleNow || !item.def.IsNutritionGivingIngestible) continue;
+                var eligible = pawns.Where(p => !item.IsForbidden(p) && p.WillEat(item)
+                    && (p.foodRestriction?.GetCurrentRespectedRestriction()?.filter.Allows(item) ?? true)
+                    && p.CanReach(item, PathEndMode.Touch, Danger.Some)).Select(p => p.thingIDNumber).ToList();
+                if (eligible.Count == 0) continue;
+                var key = string.Join(",", eligible);
+                if (!pools.TryGetValue(key, out var pool))
+                {
+                    pool = new FoodPool { PawnIds = eligible, Nutrition = 0f };
+                    pools.Add(key, pool);
+                }
+                pool.Nutrition += ResourcesHelper.GetFoodNutrition(item);
+            }
+            result.Pools = pools.Values.ToList();
+            return result;
+        }
+    }
+}
