diff --git a/Source/RIMAPI/RimworldRestApi/Models/Pawns/PawnEditDto.cs b/Source/RIMAPI/RimworldRestApi/Models/Pawns/PawnEditDto.cs
index bc1226e..ff3a990 100644
--- a/Source/RIMAPI/RimworldRestApi/Models/Pawns/PawnEditDto.cs
+++ b/Source/RIMAPI/RimworldRestApi/Models/Pawns/PawnEditDto.cs
@@ -89,6 +89,7 @@ namespace RIMAPI.Models
     {
         public int PawnId { get; set; }
         public bool? IsDrafted { get; set; }
+        public string HostilityResponse { get; set; }
         public bool Kill { get; set; }
         public bool Resurrect { get; set; }
     }
diff --git a/Source/RIMAPI/RimworldRestApi/Services/Pawns/PawnEditService/PawnEditService.cs b/Source/RIMAPI/RimworldRestApi/Services/Pawns/PawnEditService/PawnEditService.cs
index adf9b03..dacb492 100644
--- a/Source/RIMAPI/RimworldRestApi/Services/Pawns/PawnEditService/PawnEditService.cs
+++ b/Source/RIMAPI/RimworldRestApi/Services/Pawns/PawnEditService/PawnEditService.cs
@@ -242,6 +242,16 @@ namespace RIMAPI.Services
             {
                 Pawn pawn = GetPawn(request.PawnId);
 
+                if (request.HostilityResponse != null)
+                {
+                    HostilityResponseMode response;
+                    if (request.HostilityResponse != "Ignore" && request.HostilityResponse != "Attack" && request.HostilityResponse != "Flee")
+                        return ApiResult.Fail("Hostility response must be Ignore, Attack (Fight in the player UI), or Flee.");
+                    if (!Enum.TryParse(request.HostilityResponse, out response) || pawn.playerSettings == null || pawn.Faction != Faction.OfPlayer)
+                        return ApiResult.Fail("Pawn has no editable player hostility response.");
+                    pawn.playerSettings.hostilityResponse = response;
+                }
+
                 if (request.Kill && !pawn.Dead) pawn.Kill(null);
                 if (request.Resurrect && pawn.Dead) ResurrectionUtility.TryResurrect(pawn);
 
