diff --git a/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionContractController.cs b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionContractController.cs
index 1243fcc..3d7a986 100644
--- a/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionContractController.cs
+++ b/Source/RIMAPI/RimworldRestApi/Controllers/Colony/ConstructionContractController.cs
@@ -113,14 +113,37 @@ namespace RIMAPI.Controllers
         private static void PageBounds(int offset,int limit)
         { if(offset<0||limit<1||limit>32)throw new ArgumentException("offset must be nonnegative; limit must be 1..32."); }
 
+        private static ConstructionEligibility Eligibility(ThingDef def, Map map, int mapId)
+        {
+            // An inert definition carrier: no ThingMaker, spawning, IDs or reservations.
+            // MembersCanBuild reads the definition and optional style source only.
+            var candidate=new Thing{def=def};
+            var eligible=new List<int>();var reasons=new HashSet<string>();
+            foreach(var pawn in map.mapPawns.FreeColonistsSpawned.Where(p=>!p.Dead))
+            {
+                if(pawn.WorkTypeIsDisabled(WorkTypeDefOf.Construction))continue;
+                if(pawn.Ideo!=null && !pawn.Ideo.MembersCanBuild(candidate))
+                {reasons.Add("Colony constructor ideology does not permit this building.");continue;}
+                if(pawn.skills!=null && (pawn.skills.GetSkill(SkillDefOf.Construction).Level<def.constructionSkillPrerequisite || pawn.skills.GetSkill(SkillDefOf.Artistic).Level<def.artisticSkillPrerequisite))
+                {reasons.Add("Requires Construction "+def.constructionSkillPrerequisite+" and Artistic "+def.artisticSkillPrerequisite+".");continue;}
+                eligible.Add(pawn.thingIDNumber);
+            }
+            var restrictions=new List<string>();
+            if(!def.IsResearchFinished)restrictions.Add("Required research is unfinished.");
+            if(def.GetStatValueAbstract(StatDefOf.WorkToBuild)>0 && eligible.Count==0)
+            {restrictions.Add("No spawned colonist meets construction capability, skill and ideology requirements.");restrictions.AddRange(reasons.OrderBy(x=>x));}
+            return new ConstructionEligibility{MapId=mapId,ResearchFinished=def.IsResearchFinished,EligiblePawnIds=eligible,Restrictions=restrictions,
+                Scope="Spawned human colonists; definition research, construction capability, skills and native ideology rules. Does not assess mechs, materials, work priorities, health, reachability or placement. Rechecked before new placement."};
+        }
         [Post("/api/v2/construction/definitions")]
         public Task Definitions(HttpListenerContext c) => Handle<DefinitionQuery,PageBuildingDefinition>(c,q=> {
             PageBounds(q.Offset,q.Limit);
+            var map=MapHelper.GetMapByID(q.MapId);if(map==null)throw new ArgumentException("Map not found.");
             var words=q.Search.ToLowerInvariant().Split(new[]{' '},StringSplitOptions.RemoveEmptyEntries);
             var defs=DefDatabase<ThingDef>.AllDefsListForReading.Where(d=>d.category==ThingCategory.Building && d.designationCategory!=null)
                 .Where(d=>words.All(w=>(d.defName+" "+d.label).ToLowerInvariant().Contains(w))).OrderBy(d=>d.defName).ToList();
             var items=defs.Skip(q.Offset).Take(q.Limit).Select(d=>new BuildingDefinition{
-                DefName=d.defName,Label=d.label??d.defName,Description=d.description??"",IsBed=typeof(Building_Bed).IsAssignableFrom(d.thingClass),BedHumanlike=d.building?.bed_humanlike??false,SizeX=d.size.x,SizeZ=d.size.z,Rotatable=d.rotatable,
+                Eligibility=Eligibility(d,map,q.MapId),DefName=d.defName,Label=d.label??d.defName,Description=d.description??"",IsBed=typeof(Building_Bed).IsAssignableFrom(d.thingClass),BedHumanlike=d.building?.bed_humanlike??false,SizeX=d.size.x,SizeZ=d.size.z,Rotatable=d.rotatable,
                 WorkToBuild=d.GetStatValueAbstract(StatDefOf.WorkToBuild),StuffCount=d.costStuffCount,
                 Costs=(d.costList??new List<ThingDefCountClass>()).Select(x=>new Cost{DefName=x.thingDef.defName,Count=x.count}).ToList(),
                 AllowedMaterials=GenStuff.AllowedStuffsFor(d).Select(s=>new Material{DefName=s.defName,Label=s.label??s.defName}).ToList()
@@ -170,7 +193,11 @@ namespace RIMAPI.Controllers
                         var existing=pos.GetThingList(map).FirstOrDefault(t=>t.Position==pos && t.Rotation==rot &&
                             (t is Blueprint_Build blueprint ? blueprint.stuffToUse : t.Stuff)==stuff && (t.def==def||t.def.entityDefToBuild==def));
                         if(existing!=null) {r.ThingId=existing.thingIDNumber;r.State=existing is Blueprint?PlacementResultStateEnum.blueprint:existing is Frame?PlacementResultStateEnum.frame:PlacementResultStateEnum.built;}
-                        else {var report=GenConstruct.CanPlaceBlueprintAt(def,pos,rot,map,false,null,null,stuff);if(!report.Accepted)r.Reason=report.Reason??"Native placement rejected.";}
+                        else {
+                            var eligibility=Eligibility(def,map,q.MapId);
+                            if(eligibility.Restrictions.Count>0)r.Reason=string.Join(" ",eligibility.Restrictions);
+                            else {var report=GenConstruct.CanPlaceBlueprintAt(def,pos,rot,map,false,null,null,stuff);if(!report.Accepted)r.Reason=report.Reason??"Native placement rejected.";}
+                        }
                     }
                 }
                 if(r.Reason!="") {r.State=PlacementResultStateEnum.rejected;result.Accepted=false;}
