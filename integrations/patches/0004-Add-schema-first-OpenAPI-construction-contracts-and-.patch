+                    if(r.Reason=="")
+                    {
+                        var existing=pos.GetThingList(map).FirstOrDefault(t=>t.Position==pos && t.Rotation==rot &&
+                            (t is Blueprint_Build blueprint ? blueprint.stuffToUse : t.Stuff)==stuff && (t.def==def||t.def.entityDefToBuild==def));
+                        if(existing!=null) {r.ThingId=existing.thingIDNumber;r.State=existing is Blueprint?PlacementResultStateEnum.blueprint:existing is Frame?PlacementResultStateEnum.frame:PlacementResultStateEnum.built;}
+                        else {var report=GenConstruct.CanPlaceBlueprintAt(def,pos,rot,map,false,null,null,stuff);if(!report.Accepted)r.Reason=report.Reason??"Native placement rejected.";}
+                    }
+                }
+                if(r.Reason!="") {r.State=PlacementResultStateEnum.rejected;result.Accepted=false;}
+            }
+            return result;
+        }
+        [Post("/api/v2/construction/inspect")]
+        public Task InspectPlacement(HttpListenerContext c) => Handle<ConstructionRequest,ConstructionResult>(c,q=>Inspect(q,out _));
+
+        [Post("/api/v2/construction/place")]
+        public Task Place(HttpListenerContext c) => Handle<ConstructionRequest,ConstructionResult>(c,q=> {
+            var before=Inspect(q,out var map);if(!before.Accepted)return before;
+            foreach(var item in before.Items.Where(i=>i.State==PlacementResultStateEnum.ready))
+            {
+                var p=item.Placement;var def=DefDatabase<ThingDef>.GetNamed(p.DefName);
+                var stuff=p.StuffDefName==""?null:DefDatabase<ThingDef>.GetNamed(p.StuffDefName);
+                var pos=new IntVec3(p.Position.X,0,p.Position.Z);var rot=new Rot4(p.Rotation);
+                if(def.GetStatValueAbstract(StatDefOf.WorkToBuild,stuff)==0f)
+                {var thing=ThingMaker.MakeThing(def,stuff);thing.SetFactionDirect(Faction.OfPlayer);GenSpawn.Spawn(thing,pos,map,rot);}
+                else GenConstruct.PlaceBlueprintForBuild(def,pos,map,rot,Faction.OfPlayer,stuff);
+            }
+            var after=Inspect(q,out _);
+            foreach(var item in after.Items.Where(i=>i.State==PlacementResultStateEnum.ready))
+            {item.State=PlacementResultStateEnum.rejected;item.Reason="Placement was not observed after execution.";after.Accepted=false;}
+            return after;
+        });
+    }
+}
