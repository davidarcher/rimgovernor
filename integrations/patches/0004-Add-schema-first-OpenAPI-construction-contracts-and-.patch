+namespace RIMAPI.Contracts
+{
+    public static class WireContract
+    {
+        public static readonly JsonSerializerSettings Settings = new JsonSerializerSettings {
+            ContractResolver=new SnakeCaseContractResolver(),
+            NullValueHandling=NullValueHandling.Include, MissingMemberHandling=MissingMemberHandling.Error
+        };
+        public static readonly JObject Document = Load();
+        private static JObject Load()
+        {
+            using(var stream=typeof(WireContract).Assembly.GetManifestResourceStream("RIMAPI.Construction.Contracts"))
+            using(var reader=new StreamReader(stream)) return JObject.Parse(reader.ReadToEnd());
+        }
+        public static JObject Schema(Type type) => (JObject)Document["types"][type.Name];
+        public static void Validate(JToken value, JObject schema, string path="$")
+        {
+            if(schema["anyOf"] is JArray choices)
+            {
+                foreach(JObject choice in choices) { try { Validate(value,choice,path); return; } catch(JsonException) {} }
+                throw new JsonException(path+": incorrect nullable value");
+            }
+            var kind=(string)schema["type"];
+            bool ok=kind=="object"?value.Type==JTokenType.Object:kind=="array"?value.Type==JTokenType.Array:
+                kind=="string"?value.Type==JTokenType.String:kind=="boolean"?value.Type==JTokenType.Boolean:
+                kind=="integer"?value.Type==JTokenType.Integer:kind=="number"?(value.Type==JTokenType.Float||value.Type==JTokenType.Integer):value.Type==JTokenType.Null;
+            if(!ok) throw new JsonException(path+": expected "+kind);
+            if(schema["minimum"]!=null && ((double)value<(double)schema["minimum"]||(double)value>(double)schema["maximum"]))throw new JsonException(path+": number outside contract bounds");
+            if(value is JArray bounded && schema["minItems"]!=null && (bounded.Count<(int)schema["minItems"]||bounded.Count>(int)schema["maxItems"]))throw new JsonException(path+": array length outside contract bounds");
+            if(schema["enum"] is JArray allowed && !allowed.Any(x=>JToken.DeepEquals(x,value)))throw new JsonException(path+": unknown enum value");
+            if(value is JObject obj)
+            {
+                var props=(JObject)schema["properties"];
+                foreach(var p in obj.Properties()) if(props[p.Name]==null) throw new JsonException(path+": unknown field "+p.Name);
+                foreach(var p in props.Properties())
+                { if(obj[p.Name]==null) throw new JsonException(path+": missing field "+p.Name); Validate(obj[p.Name],(JObject)p.Value,path+"."+p.Name); }
+            }
+            if(value is JArray array) foreach(var item in array) Validate(item,(JObject)schema["items"],path+"[]");
+        }
+        public static async Task Send(HttpListenerContext context, object value, Type type, int status=200)
+        {
+            var token=JToken.FromObject(value,JsonSerializer.Create(Settings));
+            Validate(token,Schema(type)); // Reject server contract violations before they reach clients.
+            var bytes=Encoding.UTF8.GetBytes(token.ToString(Formatting.None));
+            context.Response.StatusCode=status; context.Response.ContentType="application/json";
+            context.Response.ContentLength64=bytes.Length;
+            await context.Response.OutputStream.WriteAsync(bytes,0,bytes.Length);
+            context.Response.Close();
+        }
+    }
