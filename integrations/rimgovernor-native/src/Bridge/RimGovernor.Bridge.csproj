<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimGovernor.Bridge</AssemblyName>
    <OutputPath>../../BridgeTools/RimGovernor/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The native build publishes it win-x64 ReadyToRun (#3291); declaring the RID keeps the lock file stable. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../scripts/fixtures/GuardedConstructionFixture.cs" Condition="'$(GuardedConstructionFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/HazardFixture.cs" Condition="'$(HazardFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ShelterFixture.cs" Condition="'$(ShelterFixture)' == 'true'" />
    <!-- The wire records (RimGovernor.Brain.Contracts, serialised with WireJson) come from the brain assemblies the mod shares with the in-process brain (#3080): one set of types, one build graph. -->
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Contracts/RimGovernor.Brain.Contracts.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
   <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.HttpChannel/RimGovernor.Brain.HttpChannel.csproj" />
    <!-- The definition catalog the in-process brain plans over is built over the game's Def objects (NativeCatalogFactory, #3116); Bridge brings Policy and Bridge.Contracts with it. -->
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Bridge/RimGovernor.Brain.Bridge.csproj" />
    <!-- The in-process brain host (#3115): BrainBootstrap starts it. Its graph (Store carries native SQLite) is referenced directly, as Policy is, so each assembly is a project output beside the Bridge and not a recorded NuGet runtime dependency. -->
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Host/RimGovernor.Brain.Host.csproj" />
   <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Observation/RimGovernor.Brain.Observation.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Store/RimGovernor.Brain.Store.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Executor/RimGovernor.Brain.Executor.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.BuildingRuntime/RimGovernor.Brain.BuildingRuntime.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.PlayerApi/RimGovernor.Brain.PlayerApi.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Simulation/RimGovernor.Brain.Simulation.csproj" />
    <!-- Direct references, like Telemetry below: a transitive project would be recorded as a NuGet runtime dependency. -->
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Bridge.Contracts/RimGovernor.Brain.Bridge.Contracts.csproj" />
    <!-- HttpChannel reports access rows through Telemetry; a direct reference keeps it a project output, not a recorded NuGet runtime dependency. -->
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
    <Compile Include="../../../../scripts/fixtures/ThroughputFixture.cs" Condition="'$(ThroughputFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/WasteFixture.cs" Condition="'$(WasteFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/BurnableFilterFixture.cs" Condition="'$(BurnableFilterFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/GearFixture.cs" Condition="'$(GearFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PopulationFixture.cs" Condition="'$(PopulationFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/HusbandryFixture.cs" Condition="'$(HusbandryFixture)' == 'true'" />

    <Compile Include="../../../../scripts/fixtures/MedicalManagementFixture.cs" Condition="'$(MedicalManagementFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ColonyReviewFixture.cs" Condition="'$(ColonyReviewFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/QuietStorytellerFixture.cs" Condition="'$(QuietStorytellerFixture)' == 'true'" />
    <!-- The native build (NativeModBuild) adds QuietStorytellerFixture, DebugStartFixture, LetterFixture and FreezeNeedsFixture to every fixture build; the extra conditions cover direct dotnet builds of the fixtures that call into them. -->
    <Compile Include="../../../../scripts/fixtures/DebugStartFixture.cs" Condition="'$(DebugStartFixture)' == 'true'" />
    <!-- The shared fixture primitives and test/stage (#3393). The stage spec's contract records are compiled in from
         their sources, not referenced as a project: this project restores locked (packages.lock.json records project
         references), so a reference present in fixture builds only would break the production build's restore. The
         production build carries none of them, which NativeModBuild checks on the built assembly. -->
    <Compile Include="../../../../scripts/fixtures/FixtureKit.cs" Condition="'$(DebugStartFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/StageFixture.cs" Condition="'$(DebugStartFixture)' == 'true'" />
    <Compile Include="../../../../brain/src/RimGovernor.Fixtures.Contracts/*.cs" Condition="'$(DebugStartFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/HuntingPredictionFixture.cs" Condition="'$(DebugStartFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/LetterFixture.cs" Condition="'$(LetterFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/DialogFixture.cs" Condition="'$(DialogFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/FreezeNeedsFixture.cs" Condition="'$(FreezeNeedsFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/UpkeepFixture.cs" Condition="'$(UpkeepFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/SleepingFixture.cs" Condition="'$(UpkeepFixture)' == 'true' Or '$(SleepingFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/TradeFixture.cs" Condition="'$(TradeFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/EmergencyDevelopmentFixture.cs" Condition="'$(EmergencyDevelopmentFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/RuntimeFaultFixture.cs" Condition="'$(RuntimeFaultFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/MapScopeFixture.cs" Condition="'$(MapScopeFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/SupportPortfolioFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PortfolioNeedsFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ServiceInvestmentFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ProductiveCookingFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PortfolioThermalFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PawnControlFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PawnDeliveryFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PawnSowFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/CoordinatedWorkFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PawnCookingFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/FoodStorageRoutesFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ClothingActivityFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/EnvironmentTemperatureFixture.cs" Condition="'$(EnvironmentTemperatureFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/QuestAcceptFixture.cs" Condition="'$(QuestAcceptFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/QuestShuttleFixture.cs" Condition="'$(QuestAcceptFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/FirstRitualFixture.cs" Condition="'$(FirstRitualFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ConvertColonistFixture.cs" Condition="'$(ConvertColonistFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/HorrorIncidentFixture.cs" Condition="'$(HorrorIncidentFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/PlanStageFixture.cs" Condition="'$(PlanStageFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/RecoveryAreaFixture.cs" Condition="'$(RecoveryAreaFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/BuriedSteelFixture.cs" Condition="'$(BuriedSteelFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/ApplyRefusalFixture.cs" Condition="'$(ApplyRefusalFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/BlightFixture.cs" Condition="'$(BlightFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/RefrigerationFixture.cs" Condition="'$(RefrigerationFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/FoodChannelFixture.cs" Condition="'$(FoodChannelFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/DeepResourcesFixture.cs" Condition="'$(DeepResourcesFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/LedgerFixture.cs" Condition="'$(LedgerFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/HuntLedgerFixture.cs" Condition="'$(HuntLedgerFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/MaintenancePracticeFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/NeedTargetCapacityFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/NeedSharedStackFixture.cs" Condition="'$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/TrainingFixture.cs" Condition="'$(TrainingFixture)' == 'true' Or '$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/SparringFixture.cs" Condition="'$(SparringFixture)' == 'true' Or '$(PawnControlFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/SparringWatchFixture.cs" Condition="'$(SparringWatchFixture)' == 'true'" />
    <Compile Include="../../../../scripts/fixtures/BabyCareFixture.cs" Condition="'$(BabyCareFixture)' == 'true'" />
    <ProjectReference Include="../Runtime/RimGovernor.Runtime.csproj"><Private>false</Private></ProjectReference>
    <!-- The host (integrations/rimgovernor-host) ships the SDK and Newtonsoft.Json in the mod's Assemblies/. -->
    <ProjectReference Include="../../../rimgovernor-host/src/Sdk/RimGovernor.Host.Sdk.csproj"><Private>false</Private></ProjectReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssembly)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)/Waylith.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RecordNativeRuntimeDependencies" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)runtime-dependencies.tsv"
      Lines="@(ReferenceCopyLocalPaths->HasMetadata('NuGetPackageId')->WithMetadataValue('Extension', '.dll')->'%(NuGetPackageId)|%(NuGetPackageVersion)|%(Filename)%(Extension)')"
      Overwrite="true" />
  </Target>
  <!-- ReadyToRun (#3291): crossgen2 references only the publish set and the runtime pack. The game's assemblies and the
       other private references ship elsewhere; without them every method that touches their types stays IL. -->
  <Target Name="ReadyToRunReferencePrivateAssemblies" BeforeTargets="_CreateR2RImages">
    <ItemGroup>
      <_ReadyToRunPrivateReference Include="@(ReferencePath)" Condition="'%(ReferencePath.Private)' == 'false' And '%(ReferencePath.FrameworkReferenceName)' == ''" />
    </ItemGroup>
    <PropertyGroup>
      <PublishReadyToRunCrossgen2ExtraArgs>@(_ReadyToRunPrivateReference->'-r:&quot;%(FullPath)&quot;')</PublishReadyToRunCrossgen2ExtraArgs>
    </PropertyGroup>
  </Target>
</Project>
