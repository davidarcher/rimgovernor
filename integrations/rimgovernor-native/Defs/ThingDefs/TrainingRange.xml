<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Training range pieces. Graphics reuse vanilla textures: no mod textures. -->

  <!-- The firing mark of one lane; the lane's training bow is issued here by the training job. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimGovernor_TrainingBowStand</defName>
    <label>training stand</label>
    <description>The firing mark of one training range lane. A colonist who trains here shoots the lane's practice bow at the dummy downrange.</description>
    <graphicData>
      <texPath>Things/Building/Joy/HorseshoesPin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <fillPercent>0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>10</costStuffCount>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
  </ThingDef>

  <!-- Hit points come from the vanilla stuff multiplier: wood, granite or plasteel. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimGovernor_TrainingDummy</defName>
    <label>training dummy</label>
    <description>A post for target practice at the end of a range lane. Arrows and blows damage it; a builder repairs it like any building.</description>
    <graphicData>
      <texPath>Things/Building/Furniture/Column</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.5,1.25)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <designationCategory>Misc</designationCategory>
  </ThingDef>

  <!-- Low partition between lanes. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimGovernor_TrainingPartition</defName>
    <label>range partition</label>
    <description>A waist-high partition that keeps neighbouring training lanes apart.</description>
    <graphicData>
      <texPath>Things/Building/Linked/Barricade_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Barricades</li>
      </linkFlags>
      <color>(139,122,87)</color>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Barricade_MenuIcon</uiIconPath>
    <uiIconScale>1.2</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.55</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>3</costStuffCount>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <isFence>true</isFence>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Barricade_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
    </building>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <designationCategory>Security</designationCategory>
  </ThingDef>

  <!-- The lane bow. No recipe, category, weapon tag or trade tag: it exists only because
       the training job issues it (#2610). Short-bow stats, so training is realistic. -->
  <ThingDef ParentName="BaseWeapon">
    <defName>Bow_Training</defName>
    <label>training bow</label>
    <description>A practice bow kept at a training range lane. It cannot be made, bought or sold.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/BowShort</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Bow_Small</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>0.8</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.25</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>Ranged</li>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Arrow_Practice</defaultProjectile>
        <warmupTime>1.35</warmupTime>
        <range>22.9</range>
        <soundCast>Bow_Small</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.TrainingTier">
        <tier>0</tier>
        <multiplier>1</multiplier>
        <xpPerShot>75</xpPerShot>
        <skillCeiling>8</skillCeiling>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Practice projectiles: one themed projectile per tier, each doing exactly 1 damage
       (never 0: Thing.TakeDamage returns early at 0). -->
  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>Arrow_Practice</defName>
    <label>practice arrow</label>
    <graphicData>
      <texPath>Things/Projectile/Arrow_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>44</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PracticeRubber</defName>
    <label>rubber bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PracticePulse</defName>
    <label>low-power pulse bolt</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>70</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PracticeBeam</defName>
    <label>hard-light bolt</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>80</speed>
    </projectile>
  </ThingDef>

  <!-- Practice weapons, tiers 1 to 3. Like Bow_Training: issued by the drill, no recipe,
       category, weapon tag or trade tag. Every tier shares the bow's 3 s cycle
       (1.35 s warmup + 1.65 s cooldown); the tier table is the TrainingTier extension. -->
  <ThingDef ParentName="BaseWeapon">
    <defName>Gun_PracticeRifle</defName>
    <label>practice rifle</label>
    <description>A rifle loaded with rubber rounds, kept at a training range lane. It cannot be made, bought or sold.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/BoltActionRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>3.5</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_PracticeRubber</defaultProjectile>
        <warmupTime>1.35</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_BoltActionRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.TrainingTier">
        <tier>1</tier>
        <multiplier>1.5</multiplier>
        <xpPerShot>112</xpPerShot>
        <skillCeiling>10</skillCeiling>
        <gateResearch>Gunsmithing</gateResearch>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BaseWeapon">
    <defName>Gun_PracticePulseRifle</defName>
    <label>practice pulse rifle</label>
    <description>A pulse rifle on a low-power setting, kept at a training range lane. It cannot be made, bought or sold.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ChargeRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>3.5</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.60</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_PracticePulse</defaultProjectile>
        <warmupTime>1.35</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.TrainingTier">
        <tier>2</tier>
        <multiplier>2.5</multiplier>
        <xpPerShot>187</xpPerShot>
        <skillCeiling>12</skillCeiling>
        <gateResearch>ChargedShot</gateResearch>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The beam emitter's gate project (BeamWeapons) ships with Odyssey; the extension
       names it as text, so this def loads without the expansion. -->
  <ThingDef ParentName="BaseWeapon">
    <defName>Gun_PracticeBeamEmitter</defName>
    <label>beam practice emitter</label>
    <description>A hard-light emitter on a harmless setting, kept at a training range lane. It cannot be made, bought or sold.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ChargeRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>3</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.90</AccuracyShort>
      <AccuracyMedium>0.80</AccuracyMedium>
      <AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_PracticeBeam</defaultProjectile>
        <warmupTime>1.35</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.TrainingTier">
        <tier>3</tier>
        <multiplier>4</multiplier>
        <xpPerShot>300</xpPerShot>
        <skillCeiling>15</skillCeiling>
        <gateResearch>BeamWeapons</gateResearch>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
