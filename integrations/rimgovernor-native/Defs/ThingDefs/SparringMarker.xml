<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- The sparring ring's marker: a pawn's gear-up spot and fighting slot on the ring's inner edge. Inert and standable, like the training range stand. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RimGovernor_SparringMarker</defName>
    <label>sparring marker</label>
    <description>Marks one fighting slot on the edge of the sparring ring. A colonist who spars gears up here and fights from this mark.</description>
    <graphicData>
      <texPath>Things/Building/Joy/HorseshoesPin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <fillPercent>0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>10</costStuffCount>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
  </ThingDef>
</Defs>
