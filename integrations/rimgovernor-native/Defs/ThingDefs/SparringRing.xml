<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Sparring ring melee practice weapons (#2703). Graphics reuse vanilla textures: no mod
       textures. Like Bow_Training: issued by the spar job, never owned; no recipe, category,
       weapon tag or trade tag; one limb tool, no verbs. Damage is flat per damage type (the
       Cut weapons share one power) and vanilla pays melee XP; a tier buys a higher ceiling
       and nothing else. The tier table is the SparringTier extension; Go mirrors it in
       sparring_tier.go. -->

  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>MeleeWeapon_PracticeClub</defName>
    <label>padded practice club</label>
    <description>A padded club for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Club</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_BluntMedium</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>1</Mass>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.SparringTier">
        <tier>0</tier>
        <skillCeiling>8</skillCeiling>
        <apparel>
          <li>Apparel_PracticeTunic</li>
        </apparel>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>MeleeWeapon_PracticeSword</defName>
    <label>practice sword</label>
    <description>A blunted sword for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Gladius</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_BladeMedium</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>1</Mass>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.SparringTier">
        <tier>1</tier>
        <skillCeiling>12</skillCeiling>
        <gateResearch>Smithing</gateResearch>
        <apparel>
          <li>Apparel_PracticeTunic</li>
          <li>Apparel_PracticeHelmet</li>
          <li>Apparel_PracticeGloves</li>
        </apparel>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>MeleeWeapon_PracticeSwordBetter</defName>
    <label>better practice sword</label>
    <description>A well-balanced blunted sword for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/LongSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_BladeMedium</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>1</Mass>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.SparringTier">
        <tier>2</tier>
        <skillCeiling>16</skillCeiling>
        <gateResearch>Machining</gateResearch>
        <apparel>
          <li>Apparel_PracticeTunic</li>
          <li>Apparel_PracticeHelmet</li>
          <li>Apparel_PracticeGloves</li>
          <li>Apparel_PracticeVest</li>
        </apparel>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>MeleeWeapon_PracticeSwordBest</defName>
    <label>best practice sword</label>
    <description>A fine blunted sword for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Plasmasword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_BladeMedium</soundInteract>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>1</Mass>
    </statBases>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.SparringTier">
        <tier>3</tier>
        <skillCeiling>20</skillCeiling>
        <gateResearch>Fabrication</gateResearch>
        <apparel>
          <li>Apparel_PracticeTunic</li>
          <li>Apparel_PracticeHelmet</li>
          <li>Apparel_PracticeGloves</li>
          <li>Apparel_PracticeVest</li>
        </apparel>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Practice apparel (#2706): issued by the spar job with the weapon, never owned. No recipe,
       category, outfit or apparel tag and tradeability None, so no outfit filter or vanilla
       optimizer ever picks them up. The tunic covers Torso and Legs (PsychologicallyNude reads
       exactly those two groups), armor 0, so cuts connect and can scar. The helmet covers
       FullHead, the group the Eye, Ear and Nose parts share with the skull. Gloves cover Hands.
       Core has no Hands layer, so gloves sit in Middle; no two pieces share a layer and a
       body-part group (tunic OnSkin, vest Middle on Torso, gloves Middle on Hands, helmet
       Overhead), so the whole set wears together. Gloves have no worn graphic, which draws
       nothing. -->

  <ThingDef Name="PracticeApparelBase" ParentName="ApparelBase" Abstract="True">
    <techLevel>Neolithic</techLevel>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>1</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <apparel>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="PracticeApparelBase">
    <defName>Apparel_PracticeTunic</defName>
    <label>practice tunic</label>
    <description>A plain tunic worn for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/TribalA/TribalA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/TribalA/TribalA</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="PracticeApparelBase">
    <defName>Apparel_PracticeHelmet</defName>
    <label>practice helmet</label>
    <description>A padded helmet worn for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/SimpleHelmet/SimpleHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>2.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>2.2</ArmorRating_Blunt>
    </statBases>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/SimpleHelmet/SimpleHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="PracticeApparelBase">
    <defName>Apparel_PracticeGloves</defName>
    <label>practice gloves</label>
    <description>Padded gloves worn for sparring, kept at a sparring ring. They cannot be made, bought or sold.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Pants/Pants</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>2.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>2.2</ArmorRating_Blunt>
    </statBases>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>Hands</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="PracticeApparelBase">
    <defName>Apparel_PracticeVest</defName>
    <label>padded practice vest</label>
    <description>A padded vest worn for sparring, kept at a sparring ring. It cannot be made, bought or sold.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
    </apparel>
  </ThingDef>
</Defs>
