    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
    <modExtensions>
      <li Class="RimGovernor.Runtime.SparringTier">
        <tier>1</tier>
        <skillCeiling>12</skillCeiling>
        <gateResearch>Smithing</gateResearch>
