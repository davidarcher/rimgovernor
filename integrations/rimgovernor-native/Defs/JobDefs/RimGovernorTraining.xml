<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- The shooting drill (JobDriver_TrainRange); ranged only since #2686. -->
  <JobDef>
    <defName>RimGovernor_TrainShooting</defName>
    <driverClass>RimGovernor.Runtime.JobDriver_TrainRange</driverClass>
    <reportString>practising archery at the range.</reportString>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>
  <!-- A pawn's part in a sparring bout (JobDriver_Spar, #2708, #2709). Never: a blow from a
       sparring partner sets the struck pawn's meleeThreat, and the only way that reaches a
       reaction mid-job is Pawn_JobTracker.Notify_DamageTaken consulting the think tree
       (JobGiver_ReactToCloseMeleeThreat, fight back with its real gear). -->
  <JobDef>
    <defName>RimGovernor_Spar</defName>
    <driverClass>RimGovernor.Runtime.JobDriver_Spar</driverClass>
    <reportString>sparring at the ring.</reportString>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
  </JobDef>
  <!-- Watching a sparring bout from a spectator cell (JobDriver_WatchSparring, #2732). joyDuration
       is the duration cap; the driver also ends when no bout is fighting or joy is full. -->
  <JobDef>
    <defName>RimGovernor_WatchSparring</defName>
    <driverClass>RimGovernor.Runtime.JobDriver_WatchSparring</driverClass>
    <reportString>watching a sparring match.</reportString>
    <joyDuration>2000</joyDuration>
    <joyKind>Social</joyKind>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>
</Defs>
