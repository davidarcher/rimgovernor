<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plays one Spec through RimWorld's own combat (RealCombat) and through the hand-ported sim, and compares the
       outcome distributions. Lives until the port is deleted (#3142). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RimGovernor.RealCombat.Parity</RootNamespace>
    <AssemblyName>RimGovernor.RealCombat.Parity</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0436;CS8981;CS0618</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="../../GameRuntime.targets" />
  <ItemGroup Condition="'$(GameAvailable)' == 'true'">
    <Compile Include="*.cs" />
    <ProjectReference Include="../RealCombat/RealCombat.csproj" />
    <ProjectReference Include="../RealCombat.Native/RealCombat.Native.csproj" />
    <ProjectReference Include="../../../../brain/src/RimGovernor.Brain.Simulation/RimGovernor.Brain.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameAvailable)' != 'true'">
    <Compile Include="../RealCombat.Host/Properties/Unavailable.cs" />
  </ItemGroup>
</Project>
