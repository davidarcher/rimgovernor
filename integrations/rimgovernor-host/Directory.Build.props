<Project>
  <!-- Vendored fork of pardeike/RimBridgeServer and pardeike/Lib.GAB (MIT); see integrations/rimgovernor-native/Notices/host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
    <HostVersion>3.0.0</HostVersion>
    <Version>$(HostVersion)</Version>
    <AssemblyVersion>$(HostVersion)</AssemblyVersion>
    <FileVersion>$(HostVersion)</FileVersion>
    <InformationalVersion>$(HostVersion)</InformationalVersion>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyAssembly>
  </PropertyGroup>
</Project>
