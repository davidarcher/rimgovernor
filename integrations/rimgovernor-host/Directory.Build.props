<Project>
  <!-- Vendored fork of pardeike/RimBridgeServer and pardeike/Lib.GAB (MIT); see integrations/rimgovernor-native/Notices/host. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
    <HostVersion>2.1.1</HostVersion>
    <Version>$(HostVersion)</Version>
    <AssemblyVersion>$(HostVersion)</AssemblyVersion>
    <FileVersion>$(HostVersion)</FileVersion>
    <InformationalVersion>$(HostVersion)</InformationalVersion>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2009463077/Current/Assemblies/0Harmony.dll</HarmonyAssembly>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep locked restore identical with and without an installed targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
