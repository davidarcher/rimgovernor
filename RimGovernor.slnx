<!-- Every C# project the gate builds (RimGovernor.cmd test): one build, one restore, one test run. The native mod and
     the contract probes build outside it (game inputs; separate output paths). The real-engine combat host
     (integrations/rimgovernor-realcombat) is listed: it compiles against the Bridge and the brain, so an API move there
     breaks it, and nothing else builds it; without the game its projects compile as stubs. -->
<Solution>
  <Folder Name="/brain/">
    <Project Path="brain/analyzers/RimGovernor.Brain.Analyzers/RimGovernor.Brain.Analyzers.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Acceptance.Cases/RimGovernor.Brain.Acceptance.Cases.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Acceptance/RimGovernor.Brain.Acceptance.csproj" />
