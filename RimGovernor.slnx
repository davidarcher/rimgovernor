    <Project Path="brain/src/RimGovernor.Brain.Runtime/RimGovernor.Brain.Runtime.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.GameFacts/RimGovernor.Brain.GameFacts.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.GameOrders/RimGovernor.Brain.GameOrders.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Domain/RimGovernor.Brain.Domain.csproj" />
