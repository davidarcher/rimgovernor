    <Project Path="brain/src/RimGovernor.Brain.PlayerApi/RimGovernor.Brain.PlayerApi.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Policy/RimGovernor.Brain.Policy.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.RemoteAccept/RimGovernor.Brain.RemoteAccept.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.RemoteBundle/RimGovernor.Brain.RemoteBundle.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Simulation/RimGovernor.Brain.Simulation.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Store/RimGovernor.Brain.Store.csproj" />
    <Project Path="brain/src/RimGovernor.Brain.Telemetry/RimGovernor.Brain.Telemetry.csproj" />
