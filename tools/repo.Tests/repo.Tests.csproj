<Project Sdk="Microsoft.NET.Sdk">
  <!-- The landing lane against throwaway git repositories (a bare origin, a main checkout, a task worktree): the lane
       moves main and pushes it, so its behavior is pinned here rather than learned on the real main. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>RimGovernor.Tools.Workflow.Tests</AssemblyName>
    <RootNamespace>RimGovernor.Tools.Workflow.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- tools/ sits outside brain/Directory.Packages.props; these repeat its central pins, keep them in step. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <!-- Compiles the contract-orphan fixtures (ContractOrphansTests); the analyzers pin the same version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- The analyzer the acceptance cases run (BannedApiTests loads it over a snippet), not applied here; the cases pin the same version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/*.dll" LinkBase="BannedApi" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../../brain/src/RimGovernor.Brain.Acceptance.Cases/BannedSymbols.txt" Link="BannedApi/BannedSymbols.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\repo\repo.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
