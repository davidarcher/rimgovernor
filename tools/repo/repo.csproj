<Project Sdk="Microsoft.NET.Sdk">
  <!-- The repo front door behind RimGovernor.cmd: land, test, issue, affected, and forwarding to the brain tool host
       (tools/rg). It references nothing under brain/, so a brain edit (or a brain compile error) never rebuilds or breaks
       it. RimGovernor.cmd publishes it ReadyToRun into .rimgovernor/tools/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>repo</AssemblyName>
    <RootNamespace>RimGovernor.Tools.Workflow</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RimGovernor.Tools.Workflow.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\common\common.csproj" />
  </ItemGroup>
</Project>
