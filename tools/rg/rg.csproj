<Project Sdk="Microsoft.NET.Sdk">
  <!-- The repo tool host (#3086): one console tool, many subcommands. RimGovernor.cmd publishes it ReadyToRun into .rimgovernor/tools/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rg</AssemblyName>
    <RootNamespace>RimGovernor.Tools</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <!-- The acceptance harness (#3087) and its cases; SelfBuild.IsStale follows these references so an edit under
       brain/ marks the published host stale. -->
  <ItemGroup>
    <ProjectReference Include="..\..\brain\src\RimGovernor.Brain.Acceptance\RimGovernor.Brain.Acceptance.csproj" />
    <ProjectReference Include="..\..\brain\src\RimGovernor.Brain.Acceptance.Cases\RimGovernor.Brain.Acceptance.Cases.csproj" />
  </ItemGroup>
</Project>
