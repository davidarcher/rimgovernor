<Project Sdk="Microsoft.NET.Sdk">
  <!-- The repo tool host (#3086): one console tool, many subcommands. RimGovernor.cmd publishes it ReadyToRun into .rimgovernor/tools/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rg</AssemblyName>
    <RootNamespace>RimGovernor.Tools</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <!-- thoughtaudit -guards (#3218): Roslyn syntax analysis of the decompiled game. Dev tool only, no reference from brain/. tools/ sits
       outside brain/Directory.Packages.props, so the version repeats that central pin (4.14.0); keep the two in step. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <!-- The colonyreview run page's player script and style sheet. -->
  <ItemGroup>
    <EmbeddedResource Include="Commands\ColonyReview\player.js" LogicalName="colonyreview.player.js" />
    <EmbeddedResource Include="Commands\ColonyReview\review.css" LogicalName="colonyreview.review.css" />
  </ItemGroup>
  <!-- The acceptance harness (#3087) and its cases; SelfBuild.IsStale follows these references so an edit under
       brain/ marks the published host stale. -->
  <ItemGroup>
    <ProjectReference Include="..\..\brain\src\RimGovernor.Brain.Acceptance\RimGovernor.Brain.Acceptance.csproj" />
    <ProjectReference Include="..\..\brain\src\RimGovernor.Brain.Acceptance.Cases\RimGovernor.Brain.Acceptance.Cases.csproj" />
    <ProjectReference Include="..\..\brain\src\RimGovernor.Brain.RemoteAccept\RimGovernor.Brain.RemoteAccept.csproj" />
    <ProjectReference Include="..\..\brain\src\RimGovernor.Brain.RemoteBundle\RimGovernor.Brain.RemoteBundle.csproj" />
  </ItemGroup>
</Project>
