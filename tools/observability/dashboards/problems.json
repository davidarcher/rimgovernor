            "uid": "loki"
          },
          "expr": "{service_name=\"rimgovernor-serve\", service_instance_id=~\"$run\"} | rimgovernor_verdict=\"refused\" | line_format \"{{.rimgovernor_kind}} [{{.rimgovernor_component}}] tick={{.rimgovernor_tick}} {{.rimgovernor_verdict}} {{.rimgovernor_reason}} {{.rimgovernor_target}} {{__line__}}\"",
          "instant": false,
          "maxLines": 200,
          "queryType": "range",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Refusals",
