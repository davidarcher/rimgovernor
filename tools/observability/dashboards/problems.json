{
  "editable": false,
  "links": [
    {
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "rimgovernor"
      ],
      "title": "RimGovernor dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "Replaces the launcher's Problems tab. WARN and ERROR rows come from Loki (the launcher's telemetry toggle must be on); native call counts come from Prometheus. Use the Run variable to pick one launch of `serve`. Panel-to-source map: `tools/observability/dashboards/README.md`.",
        "mode": "markdown"
      },
      "title": "About",
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Source: Loki rows with severity WARN in the dashboard range.",
      "fieldConfig": {
        "defaults": {
          "noValue": "none",
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"rimgovernor-serve\", service_instance_id=~\"$run\"} | severity_text=\"WARN\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "WARN rows",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Source: Loki rows with severity ERROR in the dashboard range.",
      "fieldConfig": {
        "defaults": {
          "noValue": "none",
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"rimgovernor-serve\", service_instance_id=~\"$run\"} | severity_text=\"ERROR\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "ERROR rows",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Source: counter rimgovernor.native.calls, outcome=error, increase over the dashboard range.",
      "fieldConfig": {
        "defaults": {
          "noValue": "none",
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(rimgovernor_native_calls_total{outcome=\"error\"}[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Native errors",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Source: counter rimgovernor.native.calls, increase over the dashboard range.",
      "fieldConfig": {
        "defaults": {
          "noValue": "none",
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(rimgovernor_native_calls_total[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Native calls",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Source: rimgovernor.native.calls rate over rimgovernor.scheduler.step.duration count rate (reads per step).",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rimgovernor_native_calls_total[$__rate_interval])) / sum(rate(rimgovernor_scheduler_step_duration_milliseconds_count[$__rate_interval]))",
          "legendFormat": "calls/step",
          "refId": "A"
        }
      ],
      "title": "Native calls per scheduler step",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Source: Loki rows with severity WARN or ERROR, counted per interval by kind.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (rimgovernor_kind) (count_over_time({service_name=\"rimgovernor-serve\", service_instance_id=~\"$run\"} | severity_text=~\"WARN|ERROR\" [$__interval]))",
          "instant": false,
          "queryType": "range",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "WARN and ERROR rows by kind",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Source: Loki WARN and ERROR rows counted by kind, component, verdict, reason and target over the dashboard range (the collapse key of the OTEL signals contract).",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (rimgovernor_kind, rimgovernor_component, rimgovernor_verdict, rimgovernor_reason, rimgovernor_target) (count_over_time({service_name=\"rimgovernor-serve\", service_instance_id=~\"$run\"} | severity_text=~\"WARN|ERROR\" [$__range]))",
          "instant": true,
          "queryType": "instant",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Problem rows collapsed",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count",
              "Value #A": "count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "count"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Source: Loki rows with severity WARN or ERROR, newest first. Expand a row for every attribute (rimgovernor_attr_*), the trace id and the severity.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"rimgovernor-serve\", service_instance_id=~\"$run\"} | severity_text=~\"WARN|ERROR\" | line_format \"{{.rimgovernor_kind}} [{{.rimgovernor_component}}] tick={{.rimgovernor_tick}} {{.rimgovernor_verdict}} {{.rimgovernor_reason}} {{.rimgovernor_target}} {{__line__}}\"",
          "instant": false,
          "maxLines": 200,
          "queryType": "range",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "WARN and ERROR rows",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Source: Loki decision rows with verdict refused (admission, planner and dispatch refusals), newest first.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
